<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mi arg="name">𝐓</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">t</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1" intent="cosine($arg)">
        <mi>cos</mi>
        <mrow intent="$name($var)" arg="arg">
          <mi arg="name">α</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
      <mi arg="arg2">𝐢</mi>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1" intent="cosine($arg)">
        <mi>cos</mi>
        <mrow intent="$name($var)" arg="arg">
          <mi arg="name">β</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
      <mi arg="arg2">𝐣</mi>
    </mrow>
    <mo>,</mo>
  </mrow>
</math>
