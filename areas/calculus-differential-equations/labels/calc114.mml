<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mrow intent="gradient($f)" arg="name">
        <mo>∇</mo>
        <mi arg="f">f</mi>
      </mrow>
      <mo stretchy="false">[</mo>
      <mrow arg="var" intent="$name($var)">
        <mi arg="name">𝐫</mi>
        <mo stretchy="false">(</mo>
        <mi arg="var">t</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mo stretchy="false">]</mo>
    </mrow>
    <mo>·</mo>
    <mrow intent="$name($var)">
      <mi arg="name">𝐓</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">t</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow intent="$name($var)" arg="arg1">
        <mrow arg="name">
          <msub>
            <mi>D</mi>
            <mn>1</mn>
          </msub>
          <mi>f</mi>
        </mrow>
        <mo stretchy="false">[</mo>
        <mrow arg="var" intent="$name($var)">
          <mi arg="name">𝐫</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
        <mo stretchy="false">]</mo>
      </mrow>
      <mrow intent="cosine($arg)" arg="arg2">
        <mi>cos</mi>
        <mrow intent="$name($var)" arg="arg">
          <mi arg="name">α</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow intent="$name($var)" arg="arg1">
        <mrow arg="name">
          <msub>
            <mi>D</mi>
            <mn>2</mn>
          </msub>
          <mi>f</mi>
        </mrow>
        <mo stretchy="false">[</mo>
        <mrow arg="var" intent="$name($var)">
          <mi arg="name">𝐫</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
        <mo stretchy="false">]</mo>
      </mrow>
      <mrow intent="cosine($arg)" arg="arg2">
        <mi>cos</mi>
        <mrow intent="$name($var)" arg="arg">
          <mi arg="name">β</mi>
          <mo stretchy="false">(</mo>
          <mi arg="var">t</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
