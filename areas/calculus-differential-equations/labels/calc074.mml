<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mi>r</mi>
                <mo>−</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <msup arg="arg2" intent="power($base,$exp)">
                <mrow arg="base">
                    <mo stretchy="false">(</mo>
                    <msup intent="power($base,$exp)">
                        <mi arg="base">r</mi>
                        <mn arg="exp">2</mn>
                    </msup>
                    <mo>−</mo>
                    <mrow intent="times($arg1,$arg2)">
                        <mn arg="arg1">4</mn>
                        <mi arg="arg2">r</mi>
                    </mrow>
                    <mo>+</mo>
                    <mn>5</mn>
                    <mo stretchy="false">)</mo>
                </mrow>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
    </mrow>
</math>
