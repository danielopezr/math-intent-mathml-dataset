<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac intent="partial-derivative($f,1,$v1)">
      <mrow>
        <mo>∂</mo>
        <mi arg="f">h</mi>
      </mrow>
      <mrow>
        <mo>∂</mo>
        <mi arg="v1">s</mi>
      </mrow>
    </mfrac>
    <mo>=</mo>
    <mrow intent="times($arg1,$arg2)">
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg1">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">x</mi>
        </mrow>
      </mfrac>
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg2">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">x</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">s</mi>
        </mrow>
      </mfrac>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg1">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">y</mi>
        </mrow>
      </mfrac>
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg2">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">y</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">s</mi>
        </mrow>
      </mfrac>
    </mrow>
  </mrow>
</math>
