<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <msup intent="power($base, $exp)" arg="arg2">
                <mi arg="base">&#x1D6FC;</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>=</mo>
        <mn>1</mn>
    </mrow>
</math>
