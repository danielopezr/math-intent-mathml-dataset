<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($v1, $v2)">
            <mi arg="name">φ</mi>
            <mo stretchy="false">(</mo>
            <mi arg="v1">r</mi>
            <mo>,</mo>
            <mi arg="v2">θ</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="$name($v1, $v2)">
            <mi arg="name">f</mi>
            <mo stretchy="false">(</mo>
            <mrow arg="v1" intent="times($arg1,$arg2)">
                <mi arg="arg1">r</mi>
                <mrow intent="cosine($arg)" arg="arg2">
                    <mi>cos</mi>
                    <mi arg="arg">θ</mi>
                </mrow>
            </mrow>
            <mo>,</mo>
            <mrow arg="v2" intent="times($arg1,$arg2)">
                <mi arg="arg1">r</mi>
                <mrow intent="sine($arg)" arg="arg2">
                    <mi>sen</mi>
                    <mi arg="arg">θ</mi>
                </mrow>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
