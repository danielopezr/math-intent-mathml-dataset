<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="gamma-function($var)">
            <mi>&#x1D6E4;</mi>
            <mo>(</mo>
            <mn arg="var">1</mn>
            <mo>)</mo>
        </mrow>
        <mo>=</mo>
        <mrow>
            <msubsup>
                <mo>&#x222B;</mo>
                <mn>0</mn>
                <mi>&#x221E;</mi>
            </msubsup>
            <msup intent="exponential($exp)">
                <mi>e</mi>
                <mrow arg="exp">
                    <mo>−</mo>
                    <mi>t</mi>
                </mrow>
            </msup>
            <mrow>
                <mi>d</mi>
                <mi>t</mi>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mn>1</mn>
        <mo>,</mo>
    </mrow>
</math>
