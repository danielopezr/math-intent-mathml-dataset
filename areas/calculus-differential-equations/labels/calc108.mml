<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">Y</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">x</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mi>B</mi>
        <mo>+</mo>
        <msubsup>
            <mo>∫</mo>
            <mi>a</mi>
            <mi>x</mi>
        </msubsup>
        <mrow intent="times($arg1,$arg2)">
            <mrow intent="$name($var)" arg="arg1">
                <mi arg="name">A</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">t</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">Y</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">t</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mi>d</mi>
        <mi>t</mi>
    </mrow>
</math>
