<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mi arg="name">P</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">t</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mo>[</mo>
    <mtable intent=":matrix">
      <mtr>
        <mtd>
          <mn>0</mn>
        </mtd>
        <mtd>
          <mn>1</mn>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mn>1</mn>
        </mtd>
        <mtd>
          <mrow>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
              <mn arg="arg1">2</mn>
              <mi arg="arg2">t</mi>
            </mrow>
          </mrow>
        </mtd>
      </mtr>
    </mtable>
    <mo>]</mo>
    <mo>,</mo>
  </mrow>
</math>
