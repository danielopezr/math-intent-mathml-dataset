<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msub>
            <mo>∬</mo>
            <mi>R</mi>
        </msub>
        <mi>d</mi>
        <mi>x</mi>
        <mi>d</mi>
        <mi>y</mi>
        <mo>=</mo>
        <msub>
            <mo>∬</mo>
            <msup>
                <mi>R</mi>
                <mo>*</mo>
            </msup>
        </msub>
        <mrow intent="absolute-value($a)">
            <mo stretchy="false">|</mo>
            <mrow arg="a" intent="$name($v1, $v2)">
                <mi arg="name">J</mi>
                <mo stretchy="false">(</mo>
                <mi arg="v1">u</mi>
                <mo>,</mo>
                <mi arg="v2">v</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mo stretchy="false">|</mo>
        </mrow>
        <mi>d</mi>
        <mi>u</mi>
        <mi>d</mi>
        <mi>v</mi>
        <mo>,</mo>
    </mrow>
