<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac intent="partial-derivative($f,1,$v1)">
            <mrow>
                <mo>∂</mo>
                <mi arg="f">x</mi>
            </mrow>
            <mrow>
                <mo>∂</mo>
                <mi arg="v1">r</mi>
            </mrow>
        </mfrac>
        <mo>=</mo>
        <mrow intent="cosine($arg)">
            <mi>cos</mi>
            <mi arg="arg">θ</mi>
        </mrow>
        <mo>,</mo>
    </mrow>
</math>
