<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mi arg="name">f</mi>
      <mo stretchy="false">(</mo>
      <mrow arg="var">
        <mi>𝐚</mi>
        <mo>+</mo>
        <mi>𝐲</mi>
      </mrow>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>−</mo>
    <mrow intent="$name($var)">
      <mi arg="name">f</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">𝐚</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mrow intent="$name($var)">
      <mrow intent="gradient($f)" arg="name">
        <mo>∇</mo>
        <mi arg="f">f</mi>
      </mrow>
      <mo stretchy="false">(</mo>
      <mi arg="var">𝐚</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>·</mo>
    <mi>𝐲</mi>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
      <mfrac arg="arg1">
        <mn>1</mn>
        <mrow intent="factorial($var)">
          <mn arg="var">2</mn>
          <mo>!</mo>
        </mrow>
      </mfrac>
      <mi arg="arg2">𝐲</mi>
      <mrow intent="$name($var)" arg="arg3">
        <mi arg="name">H</mi>
        <mo stretchy="false">(</mo>
        <mi arg="var">𝐚</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <msup arg="arg4" intent="power($base,$exp)">
        <mi arg="base">𝐲</mi>
        <mi arg="exp">t</mi>
      </msup>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <msup arg="arg1" intent="power($base,$exp)">
        <mrow intent="norm($a)" arg="base">
          <mo fence="false" stretchy="false">‖</mo>
          <mi arg="a">𝐲</mi>
          <mo fence="false" stretchy="false">‖</mo>
        </mrow>
        <mn arg="exp">2</mn>
      </msup>
      <mrow intent="$name($v1, $v2)" arg="arg2">
        <msub arg="name">
          <mi>E</mi>
          <mn>2</mn>
        </msub>
        <mo stretchy="false">(</mo>
        <mi arg="v1">𝐚</mi>
        <mo>,</mo>
        <mi arg="v2">𝐲</mi>
        <mo stretchy="false">)</mo>
      </mrow>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
