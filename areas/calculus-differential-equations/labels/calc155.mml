<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($v1, $v2)">
            <mi arg="name">f</mi>
            <mo stretchy="false">(</mo>
            <mi arg="v1">x</mi>
            <mo>,</mo>
            <mi arg="v2">y</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <msup intent="exponential($exp)">
            <mi>e</mi>
            <mrow arg="exp">
                <mi>x</mi>
                <mo>+</mo>
                <mi>y</mi>
            </mrow>
        </msup>
    </mrow>
</math>
