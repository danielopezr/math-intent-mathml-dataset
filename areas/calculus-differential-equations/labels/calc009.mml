<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
    <mi>y</mi>
    <mo>=</mo>
    <mrow intent="times($a, $b)">
        <msub arg="a">
            <mi>c</mi>
            <mn>1</mn>
        </msub>
        <msup arg="b" intent="exponential($exp)">
            <mi>e</mi>
            <mi arg="exp">x</mi>
        </msup>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($a, $b)">
        <msup arg="a" intent="exponential($exp)">
            <mi>e</mi>
            <mrow arg="exp" intent="times($arg1,$arg2)">
                <mn arg="arg1">2</mn>
                <mi arg="arg2">x</mi>
            </mrow>
        </msup>
        <mrow arg="b">
            <mo>[</mo>
            <mrow intent="times($x, $y)">
                <mrow arg="x">
                    <mo>(</mo>
                    <msub>
                        <mi>c</mi>
                        <mn>2</mn>
                    </msub>
                    <mo>+</mo>
                    <mrow intent="times($arg1,$arg2)">
                        <msub arg="arg1">
                            <mi>c</mi>
                            <mn>3</mn>
                        </msub>
                        <mi arg="arg2">x</mi>
                    </mrow>
                    <mo>)</mo>
                </mrow>
                <mrow arg="y" intent="cosine($var)">
                    <mi>cos</mi>
                    <mi arg="var">x</mi>
                </mrow>
            </mrow>
            <mo>+</mo>
            <mrow intent="times($x, $y)">
                <mrow arg="x">
                    <mo>(</mo>
                    <msub>
                        <mi>c</mi>
                        <mn>4</mn>
                    </msub>
                    <mo>+</mo>
                    <mrow intent="times($arg1,$arg2)">
                        <msub arg="arg1">
                            <mi>c</mi>
                            <mn>5</mn>
                        </msub>
                        <mi arg="arg2">x</mi>
                    </mrow>
                    <mo>)</mo>
                </mrow>
                <mrow arg="y" intent="sine($var)">
                    <mi>sen</mi>
                    <mi arg="var">x</mi>
                </mrow>
            </mrow>
            <mo>]</mo>
        </mrow>
    </mrow>
</mrow>
</math>
