<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msup arg="name" intent="derivative($y,_x,1)">
                <mi arg="y">Y</mi>
                <mi>′</mi>
            </msup>
            <mo stretchy="false">(</mo>
            <mi arg="var">x</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow intent="$name($var)" arg="arg1">
                <mi arg="name">A</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">Y</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
