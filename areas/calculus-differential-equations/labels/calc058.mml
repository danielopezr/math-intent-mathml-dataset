<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($a, $b)">
            <mn arg="a">2</mn>
            <mrow arg="b">
                <msubsup>
                    <mo>&#x222B;</mo>
                    <mn>0</mn>
                    <mi>&#x221E;</mi>
                </msubsup>
                <msup intent="exponential($exp)">
                    <mi>e</mi>
                    <mrow arg="exp">
                        <mo>−</mo>
                        <msup intent="power($ba, $e)">
                            <mi arg="ba">u</mi>
                            <mn arg="e">2</mn>
                        </msup>
                    </mrow>
                </msup>
                <mrow>
                    <mi>d</mi>
                    <mi>u</mi>
                </mrow>
            </mrow>
        </mrow>
        <mo>=</mo>
        <msqrt>
            <mi>&#x1D70B;</mi>
        </msqrt>
        <mo>.</mo>
    </mrow>
</math>
