<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac intent="partial-derivative($f,1,$v1)">
      <mrow>
        <mo>∂</mo>
        <mi arg="f">x</mi>
      </mrow>
      <mrow>
        <mo>∂</mo>
        <mi arg="v1">θ</mi>
      </mrow>
    </mfrac>
    <mo>=</mo>
    <mo>−</mo>
    <mrow intent="times($arg1,$arg2)">
      <mi arg="arg1">r</mi>
      <mrow intent="sine($arg)" arg="arg2">
        <mi>sen</mi>
        <mi arg="arg">θ</mi>
      </mrow>
    </mrow>
    <mo>,</mo>
  </mrow>
</math>
