<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>𝐓</mi>
                <mi>𝐚</mi>
            </msub>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐲</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <msubsup>
            <mo>∑</mo>
            <mrow>
                <mi>k</mi>
                <mo>=</mo>
                <mn>1</mn>
            </mrow>
            <mi>m</mi>
        </msubsup>
        <mrow intent="$name($var)">
            <mrow intent="gradient($f)" arg="name">
                <mo>∇</mo>
                <msub arg="f">
                    <mi>f</mi>
                    <mi>k</mi>
                </msub>
            </mrow>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐚</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>·</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">𝐲</mi>
            <msub arg="arg2">
                <mi>𝐞</mi>
                <mi>k</mi>
            </msub>
        </mrow>
        <mo>=</mo>
        <mo stretchy="false">(</mo>
        <mrow intent="$name($var)">
            <mrow intent="gradient($f)" arg="name">
                <mo>∇</mo>
                <msub arg="f">
                    <mi>f</mi>
                    <mn>1</mn>
                </msub>
            </mrow>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐚</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>·</mo>
        <mi>𝐲</mi>
        <mo>,</mo>
        <mo intent="ellipsis">…</mo>
        <mo>,</mo>
        <mrow intent="$name($var)">
            <mrow intent="gradient($f)" arg="name">
                <mo>∇</mo>
                <msub arg="f">
                    <mi>f</mi>
                    <mi>m</mi>
                </msub>
            </mrow>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐚</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>·</mo>
        <mi>𝐲</mi>
        <mo stretchy="false">)</mo>
        <mo>.</mo>
    </mrow>
</math>
