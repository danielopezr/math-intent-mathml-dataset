<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <msup intent="power($base,$exp)">
      <mrow arg="base">
        <mo stretchy="false">(</mo>
        <mi>x</mi>
        <mo>−</mo>
        <mi>a</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mn arg="exp">2</mn>
    </msup>
    <mo>+</mo>
    <msup intent="power($base,$exp)">
      <mrow arg="base">
        <mo stretchy="false">(</mo>
        <mi>y</mi>
        <mo>−</mo>
        <mi>b</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mn arg="exp">2</mn>
    </msup>
    <mo>+</mo>
    <msup intent="power($base,$exp)">
      <mrow arg="base">
        <mo stretchy="false">(</mo>
        <mi>z</mi>
        <mo>−</mo>
        <mi>c</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mn arg="exp">2</mn>
    </msup>
    <mo>=</mo>
    <mn>1</mn>
  </mrow>
</math>
