      <mo stretchy="false">(</mo>
      <mi arg="v1">x</mi>
      <mo>,</mo>
      <mi arg="v2">y</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>≤</mo>
    <mrow intent="$name($v1, $v2)">
      <mi arg="name">f</mi>
      <mo stretchy="false">(</mo>
      <mi arg="v1">x</mi>
      <mo>,</mo>
      <mi arg="v2">y</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>≤</mo>
    <mrow intent="$name($v1, $v2)">
      <mi arg="name">t</mi>
      <mo stretchy="false">(</mo>
      <mi arg="v1">x</mi>
      <mo>,</mo>
      <mi arg="v2">y</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>,</mo>
