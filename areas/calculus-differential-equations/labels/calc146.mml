<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac intent="partial-derivative($f,1,$v1)">
            <mrow>
                <mo>∂</mo>
                <mi arg="f">f</mi>
            </mrow>
            <mrow>
                <mo>∂</mo>
                <mi arg="v1">y</mi>
            </mrow>
        </mfrac>
        <mo>=</mo>
        <mrow intent="$name($v1, $v2)">
            <mrow arg="name">
                <msub>
                    <mi>D</mi>
                    <mn>2</mn>
                </msub>
                <mi>f</mi>
            </mrow>
            <mo stretchy="false">(</mo>
            <mrow arg="v1" intent="times($arg1,$arg2)">
                <mi arg="arg1">r</mi>
                <mrow intent="cosine($arg)" arg="arg2">
                    <mi>cos</mi>
                    <mi arg="arg">θ</mi>
                </mrow>
            </mrow>
            <mo>,</mo>
            <mrow arg="v2" intent="times($arg1,$arg2)">
                <mi arg="arg1">r</mi>
                <mrow intent="sine($arg)" arg="arg2">
                    <mi>sen</mi>
                    <mi arg="arg">θ</mi>
                </mrow>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
