<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mtable>
            <mtr>
                <mtd>
                    <mrow>
                        <mi>x</mi>
                        <mo>=</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">r</mi>
                            <mrow intent="cosine($arg)" arg="arg2">
                                <mi>cos</mi>
                                <mi arg="arg">θ</mi>
                            </mrow>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <mi>y</mi>
                        <mo>=</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">r</mi>
                            <mrow intent="sine($arg)" arg="arg2">
                                <mi>sen</mi>
                                <mi arg="arg">θ</mi>
                            </mrow>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <mi>z</mi>
                        <mo>=</mo>
                        <mi>z</mi>
                    </mrow>
                </mtd>
            </mtr>
        </mtable>
    </mrow>
</math>
