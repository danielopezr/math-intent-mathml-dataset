<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="curl($f)">
      <mi>rot</mi>
      <mi arg="f">𝐅</mi>
    </mrow>
    <mo>=</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1">
        <mo stretchy="true" fence="true" form="prefix">(</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">R</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">y</mi>
          </mrow>
        </mfrac>
        <mo>−</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">Q</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">z</mi>
          </mrow>
        </mfrac>
        <mo stretchy="true" fence="true" form="postfix">)</mo>
      </mrow>
      <mi arg="arg2">𝐢</mi>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1">
        <mo stretchy="true" fence="true" form="prefix">(</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">P</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">z</mi>
          </mrow>
        </mfrac>
        <mo>−</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">R</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">x</mi>
          </mrow>
        </mfrac>
        <mo stretchy="true" fence="true" form="postfix">)</mo>
      </mrow>
      <mi arg="arg2">𝐣</mi>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1">
        <mo stretchy="true" fence="true" form="prefix">(</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">Q</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">x</mi>
          </mrow>
        </mfrac>
        <mo>−</mo>
        <mfrac intent="partial-derivative($f,1,$v1)">
          <mrow>
            <mo>∂</mo>
            <mi arg="f">P</mi>
          </mrow>
          <mrow>
            <mo>∂</mo>
            <mi arg="v1">y</mi>
          </mrow>
        </mfrac>
        <mo stretchy="true" fence="true" form="postfix">)</mo>
      </mrow>
      <mi arg="arg2">𝐤</mi>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
