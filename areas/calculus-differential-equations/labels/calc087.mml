<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow intent="times($arg1,$arg2)">
    <msub arg="arg1">
      <mi>A</mi>
      <mrow intent="times($arg1,$arg2)">
        <mn arg="arg1">2</mn>
        <mi arg="arg2">p</mi>
      </mrow>
    </msub>
    <mrow intent="logarithm($arg)" arg="arg2">
      <mi>log</mi>
      <mi arg="arg">x</mi>
    </mrow>
  </mrow>
</math>
