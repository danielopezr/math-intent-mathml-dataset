<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <msub>
                    <mi>h</mi>
                    <mi>n</mi>
                </msub>
                <mo>+</mo>
                <msub>
                    <mi>h</mi>
                    <mrow>
                        <mi>n</mi>
                        <mo>+</mo>
                        <mi>p</mi>
                    </mrow>
                </msub>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mrow intent="factorial($var)" arg="arg1">
                    <mi arg="var">n</mi>
                    <mo>!</mo>
                </mrow>
                <mrow intent="factorial($var)" arg="arg2">
                    <mo stretchy="false">(</mo>
                    <mrow arg="var">
                        <mi>n</mi>
                        <mo>+</mo>
                        <mi>p</mi>
                    </mrow>
                    <mo stretchy="false">)</mo>
                    <mo>!</mo>
                </mrow>
            </mrow>
        </mfrac>
    </mrow>
</math>
