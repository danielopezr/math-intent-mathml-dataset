<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">f</mi>
            <mo stretchy="false">(</mo>
            <mrow arg="var">
                <mi>𝐚</mi>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mi arg="arg1">h</mi>
                    <mi arg="arg2">𝐲</mi>
                </mrow>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>−</mo>
        <mrow intent="$name($var)">
            <mi arg="name">f</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐚</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>T</mi>
                <mi>𝐚</mi>
            </msub>
            <mo stretchy="false">(</mo>
            <mrow arg="var" intent="times($arg1,$arg2)">
                <mi arg="arg1">h</mi>
                <mi arg="arg2">𝐲</mi>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow intent="norm($a)" arg="arg1">
                <mo fence="false" stretchy="false">‖</mo>
                <mrow arg="a" intent="times($arg1,$arg2)">
                    <mi arg="arg1">h</mi>
                    <mi arg="arg2">𝐲</mi>
                </mrow>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mrow intent="$name($v1, $v2)" arg="arg2">
                <mi arg="name">E</mi>
                <mo stretchy="false">(</mo>
                <mi arg="v1">𝐚</mi>
                <mo>,</mo>
                <mi arg="v2">𝐯</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">h</mi>
            <mrow intent="$name($var)" arg="arg2">
                <msub arg="name">
                    <mi>T</mi>
                    <mi>𝐚</mi>
                </msub>
                <mo stretchy="false">(</mo>
                <mi arg="var">𝐲</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mrow intent="absolute-value($a)" arg="arg1">
                <mo stretchy="false">|</mo>
                <mi arg="a">h</mi>
                <mo stretchy="false">|</mo>
            </mrow>
            <mrow intent="norm($a)" arg="arg2">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐲</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mrow intent="$name($v1, $v2)" arg="arg3">
                <mi arg="name">E</mi>
                <mo stretchy="false">(</mo>
                <mi arg="v1">𝐚</mi>
                <mo>,</mo>
                <mi arg="v2">𝐯</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
