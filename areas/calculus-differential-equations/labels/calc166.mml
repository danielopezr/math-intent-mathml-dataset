<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mi arg="name">G</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">x</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mrow intent="$name($v1, $v2)">
      <mi arg="name">g</mi>
      <mo stretchy="false">[</mo>
      <mi arg="v1">x</mi>
      <mo>,</mo>
      <mrow arg="v2" intent="$name($var)">
        <mi arg="name">Y</mi>
        <mo stretchy="false">(</mo>
        <mi arg="var">x</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mo stretchy="false">]</mo>
    </mrow>
  </mrow>
</math>
