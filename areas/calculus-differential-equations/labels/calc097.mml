              </mrow>
            </msub>
          </mrow>
        </mtd>
        <mtd>
          <mrow>
            <mo>−</mo>
            <msub>
              <mi>a</mi>
              <mrow>
                <mi>n</mi>
                <mo>−</mo>
                <mn>2</mn>
              </mrow>
            </msub>
          </mrow>
        </mtd>
        <mtd>
          <mo intent="ellipsis">⋯</mo>
        </mtd>
        <mtd>
          <mrow>
            <mo>−</mo>
            <msub>
              <mi>a</mi>
              <mn>1</mn>
            </msub>
          </mrow>
        </mtd>
      </mtr>
    </mtable>
    <mo>]</mo>
    <mo>,</mo>
  </mrow>
</math>
