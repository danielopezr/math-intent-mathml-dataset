        </mtd>
        <mtd>
          <mn>0</mn>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mo>⋮</mo>
        </mtd>
        <mtd>
          <mo>⋮</mo>
        </mtd>
        <mtd>
          <mo>⋮</mo>
        </mtd>
        <mtd/>
        <mtd>
          <mo>⋮</mo>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mn>0</mn>
        </mtd>
        <mtd>
          <mn>0</mn>
        </mtd>
        <mtd>
          <mn>0</mn>
        </mtd>
        <mtd>
          <mo intent="ellipsis">⋯</mo>
        </mtd>
        <mtd>
          <mn>1</mn>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mrow>
            <mo>−</mo>
            <msub>
              <mi>a</mi>
              <mi>n</mi>
            </msub>
          </mrow>
        </mtd>
        <mtd>
          <mrow>
            <mo>−</mo>
            <msub>
              <mi>a</mi>
              <mrow>
                <mi>n</mi>
                <mo>−</mo>
