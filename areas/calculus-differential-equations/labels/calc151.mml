<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac intent="partial-derivative($f,2,$v1)">
      <mrow>
        <msup>
          <mo>∂</mo>
          <mn>2</mn>
        </msup>
        <mrow arg="f" intent="$name($v1, $v2)">
          <mi arg="name">f</mi>
          <mo stretchy="false">(</mo>
          <mi arg="v1">x</mi>
          <mo>,</mo>
          <mi arg="v2">y</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
      <mrow>
        <mo>∂</mo>
        <msup>
          <mi arg="v1">x</mi>
          <mn>2</mn>
        </msup>
      </mrow>
    </mfrac>
    <mo>+</mo>
    <mfrac intent="partial-derivative($f,2,$v1)">
      <mrow>
        <msup>
          <mo>∂</mo>
          <mn>2</mn>
        </msup>
        <mrow arg="f" intent="$name($v1, $v2)">
          <mi arg="name">f</mi>
          <mo stretchy="false">(</mo>
          <mi arg="v1">x</mi>
          <mo>,</mo>
          <mi arg="v2">y</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mrow>
      <mrow>
        <mo>∂</mo>
        <msup>
          <mi arg="v1">y</mi>
          <mn>2</mn>
        </msup>
      </mrow>
    </mfrac>
    <mo>=</mo>
    <mn>0</mn>
    <mo>.</mo>
  </mrow>
</math>
