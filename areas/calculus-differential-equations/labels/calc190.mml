<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="times($arg1,$arg2)">
      <mrow arg="arg1">
        <mo stretchy="false">(</mo>
        <msub>
          <mi>b</mi>
          <mn>1</mn>
        </msub>
        <mo>−</mo>
        <msub>
          <mi>a</mi>
          <mn>1</mn>
        </msub>
        <mo stretchy="false">)</mo>
      </mrow>
      <mo intent="ellipsis">⋯</mo>
      <mrow arg="arg2">
        <mo stretchy="false">(</mo>
        <msub>
          <mi>b</mi>
          <mi>n</mi>
        </msub>
        <mo>−</mo>
        <msub>
          <mi>a</mi>
          <mi>n</mi>
        </msub>
        <mo stretchy="false">)</mo>
      </mrow>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
