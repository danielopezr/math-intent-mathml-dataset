<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mrow arg="name">
                <mi>D</mi>
                <mi>𝐗</mi>
            </mrow>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐮</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mo>[</mo>
        <mtable intent=":matrix">
            <mtr>
                <mtd>
                    <mrow intent="$name($var)">
