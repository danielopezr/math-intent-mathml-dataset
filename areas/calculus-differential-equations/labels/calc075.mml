<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
        <mrow arg="arg1">
            <mo stretchy="false">(</mo>
            <mn>1</mn>
            <mo>−</mo>
            <mi>α</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mrow arg="arg2">
            <mo stretchy="false">(</mo>
            <mn>2</mn>
            <mo>−</mo>
            <mi>α</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo intent="ellipsis">⋯</mo>
        <mrow arg="arg3">
            <mo stretchy="false">(</mo>
            <mi>n</mi>
            <mo>−</mo>
            <mi>α</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mrow intent="gamma-function($arg)" arg="arg4">
            <mi>Γ</mi>
            <mo stretchy="false">(</mo>
            <mrow arg="arg">
                <mn>1</mn>
                <mo>−</mo>
                <mi>α</mi>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
    </mrow>
</math>
