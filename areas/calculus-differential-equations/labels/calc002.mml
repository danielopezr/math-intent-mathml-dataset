<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>𝐫</mi>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">x</mi>
            <mi arg="arg2">𝐢</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">y</mi>
            <mi arg="arg2">𝐣</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">z</mi>
            <mi arg="arg2">𝐤</mi>
        </mrow>
    </mrow>
</math>
