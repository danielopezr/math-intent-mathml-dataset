<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">f</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐱</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>&lt;</mo>
        <mi>M</mi>
        <mo>−</mo>
        <mrow intent="fraction($num,$den)">
            <mn arg="num">1</mn>
            <mo>/</mo>
            <mi arg="den">C</mi>
        </mrow>
    </mrow>
</math>
