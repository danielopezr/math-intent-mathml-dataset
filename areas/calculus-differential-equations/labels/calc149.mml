<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac intent="partial-derivative($f,2,$v1)">
      <mrow>
        <msup>
          <mo>∂</mo>
          <mn>2</mn>
        </msup>
        <mi arg="f">φ</mi>
      </mrow>
      <mrow>
        <mo>∂</mo>
        <msup>
          <mi arg="v1">θ</mi>
          <mn>2</mn>
        </msup>
      </mrow>
    </mfrac>
    <mo>=</mo>
    <mo>−</mo>
    <mrow intent="times($arg1,$arg2,$arg3)">
      <mi arg="arg1">r</mi>
      <mrow intent="cosine($arg)" arg="arg2">
        <mi>cos</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg3">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">x</mi>
        </mrow>
      </mfrac>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2,$arg3)">
      <msup arg="arg1" intent="power($base,$exp)">
        <mi arg="base">r</mi>
        <mn arg="exp">2</mn>
      </msup>
      <mrow intent="power(sine($var),2)" arg="arg2">
        <msup>
          <mi>sen</mi>
          <mn>2</mn>
        </msup>
        <mi arg="var">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,2,$v1)" arg="arg3">
        <mrow>
          <msup>
            <mo>∂</mo>
            <mn>2</mn>
          </msup>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <msup>
            <mi arg="v1">x</mi>
            <mn>2</mn>
          </msup>
        </mrow>
      </mfrac>
    </mrow>
    <mo>−</mo>
    <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
      <msup arg="arg1" intent="power($base,$exp)">
        <mi arg="base">r</mi>
        <mn arg="exp">2</mn>
      </msup>
      <mrow intent="sine($arg)" arg="arg2">
        <mi>sen</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mrow intent="cosine($arg)" arg="arg3">
        <mi>cos</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,2,$v1,$v2)" arg="arg4">
        <mrow>
          <msup>
            <mo>∂</mo>
            <mn>2</mn>
          </msup>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">y</mi>
          <mo>∂</mo>
          <mi arg="v2">x</mi>
        </mrow>
      </mfrac>
    </mrow>
    <mo>−</mo>
    <mrow intent="times($arg1,$arg2,$arg3)">
      <mi arg="arg1">r</mi>
      <mrow intent="sine($arg)" arg="arg2">
        <mi>sen</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,1,$v1)" arg="arg3">
        <mrow>
          <mo>∂</mo>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">y</mi>
        </mrow>
      </mfrac>
    </mrow>
    <mo>−</mo>
    <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
      <msup arg="arg1" intent="power($base,$exp)">
        <mi arg="base">r</mi>
        <mn arg="exp">2</mn>
      </msup>
      <mrow intent="sine($arg)" arg="arg2">
        <mi>sen</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mrow intent="cosine($arg)" arg="arg3">
        <mi>cos</mi>
        <mi arg="arg">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,2,$v1,$v2)" arg="arg4">
        <mrow>
          <msup>
            <mo>∂</mo>
            <mn>2</mn>
          </msup>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <mi arg="v1">x</mi>
          <mo>∂</mo>
          <mi arg="v2">y</mi>
        </mrow>
      </mfrac>
    </mrow>
    <mo>+</mo>
    <mrow intent="times($arg1,$arg2,$arg3)">
      <msup arg="arg1" intent="power($base,$exp)">
        <mi arg="base">r</mi>
        <mn arg="exp">2</mn>
      </msup>
      <mrow intent="power(cosine($var),2)" arg="arg2">
        <msup>
          <mi>cos</mi>
          <mn>2</mn>
        </msup>
        <mi arg="var">θ</mi>
      </mrow>
      <mfrac intent="partial-derivative($f,2,$v1)" arg="arg3">
        <mrow>
          <msup>
            <mo>∂</mo>
            <mn>2</mn>
          </msup>
          <mi arg="f">f</mi>
        </mrow>
        <mrow>
          <mo>∂</mo>
          <msup>
            <mi arg="v1">y</mi>
            <mn>2</mn>
          </msup>
        </mrow>
      </mfrac>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
