<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="$name($var)">
      <mi arg="name">φ</mi>
      <mo stretchy="false">(</mo>
      <mi arg="var">t</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mo>=</mo>
    <mrow intent="$name($v1, $v2)">
      <mi arg="name">g</mi>
      <mo stretchy="false">[</mo>
      <mrow arg="v1" intent="$name($var)">
        <mi arg="name">A</mi>
        <mo stretchy="false">(</mo>
        <mi arg="var">t</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mo>,</mo>
      <mrow arg="v2" intent="$name($var)">
        <mi arg="name">B</mi>
        <mo stretchy="false">(</mo>
        <mi arg="var">t</mi>
        <mo stretchy="false">)</mo>
      </mrow>
      <mo stretchy="false">]</mo>
    </mrow>
    <mo>.</mo>
  </mrow>
</math>
