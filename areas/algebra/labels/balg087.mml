<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>x</mi>
                <mo>−</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>−</mo>
        <mo stretchy="false">(</mo>
        <mi>x</mi>
        <mo>−</mo>
        <mn>3</mn>
        <mo stretchy="false">)</mo>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>3</mn>
            </mfrac>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>x</mi>
                <mo>+</mo>
                <mn>3</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mfrac>
            <mn>1</mn>
            <mn>6</mn>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
