<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <msup intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mn>3</mn>
        </mfrac>
        <mo>−</mo>
        <mfrac>
            <msup intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mn>2</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <msup intent="power($base,$exp)">
                <mi arg="base">m</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mn>6</mn>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
