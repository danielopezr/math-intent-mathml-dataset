<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">3.4</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">4</mn>
            </msup>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">5.6</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">4</mn>
            </msup>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
