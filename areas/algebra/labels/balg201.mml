<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>3</mn>
                    <mn>4</mn>
                </mfrac>
                <msup arg="arg2" intent="power($base,$exp)">
                    <mi arg="base">b</mi>
                    <mn arg="exp">3</mn>
                </msup>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>2</mn>
                    <mn>3</mn>
                </mfrac>
                <msup arg="arg2" intent="power($base,$exp)">
                    <mi arg="base">c</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
