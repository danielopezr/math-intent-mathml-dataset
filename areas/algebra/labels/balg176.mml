<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow intent="times($arg1,$arg2,$arg3)">
                <mn arg="arg1">24</mn>
                <mi arg="arg2">m</mi>
                <mi arg="arg3">n</mi>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">2</mn>
                <msqrt arg="arg2">
                    <mrow intent="times($arg1,$arg2)">
                        <msup arg="arg1" intent="power($base,$exp)">
                            <mi arg="base">n</mi>
                            <mn arg="exp">2</mn>
                        </msup>
                        <msup arg="arg2" intent="power($base,$exp)">
                            <mi arg="base">p</mi>
                            <mn arg="exp">2</mn>
                        </msup>
                    </mrow>
                </msqrt>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
