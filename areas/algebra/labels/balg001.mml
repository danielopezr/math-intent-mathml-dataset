<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <mn>1</mn>
                <mo>+</mo>
                <mi>r</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="exp">
                <mi>t</mi>
                <mo>−</mo>
                <mn>2</mn>
            </mrow>
        </msup>
        <mo>,</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">i</mi>
            <msup arg="arg2" intent="power($base,$exp)">
                <mrow arg="base">
                    <mo stretchy="false">(</mo>
                    <mn>1</mn>
                    <mo>+</mo>
                    <mi>r</mi>
                    <mo stretchy="false">)</mo>
                </mrow>
                <mrow arg="exp">
                    <mi>t</mi>
                    <mo>−</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>,</mo>
        <mo intent="ellipsis">…</mo>
        <mo>,</mo>
    </mrow>
</math>
