<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>+</mo>
        <mi>a</mi>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>+</mo>
        <mn>5</mn>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">7</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <mi arg="arg2">a</mi>
        </mrow>
        <mo>;</mo>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">8</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mn>6</mn>
        <mo>.</mo>
    </mrow>
</math>
