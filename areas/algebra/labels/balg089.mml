<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">4</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>+</mo>
                <mn>1</mn>
            </mrow>
            <mn>3</mn>
        </mfrac>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>3</mn>
            </mfrac>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">4</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>−</mo>
        <mfrac>
            <mrow>
                <mn>13</mn>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">2</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
            </mrow>
            <mn>6</mn>
        </mfrac>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>x</mi>
                <mo>−</mo>
                <mn>3</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
