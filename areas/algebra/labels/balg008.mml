<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base, $exp)">
            <mi arg="base">b</mi>
            <mrow arg="exp">
                <mi>x</mi>
                <mo>+</mo>
                <mi>y</mi>
            </mrow>
        </msup>
        <mo>=</mo>
        <mrow>
            <mi>A</mi>
            <mo>×</mo>
            <mi>B</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
