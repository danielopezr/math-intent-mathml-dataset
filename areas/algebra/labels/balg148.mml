<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">4</mn>
        </msup>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">6</mn>
        </msup>
        <mo>+</mo>
        <mn>6</mn>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">5</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">3</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <mn>8</mn>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>−</mo>
        <mn>14</mn>
        <mo>.</mo>
    </mrow>
</math>
