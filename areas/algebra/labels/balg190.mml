<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">5</mn>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">b</mi>
        </mrow>
        <mo>=</mo>
        <mn>5</mn>
        <mo>×</mo>
        <mn>1</mn>
        <mo>×</mo>
        <mn>2</mn>
        <mo>=</mo>
        <mn>10</mn>
        <mo>.</mo>
    </mrow>
</math>
