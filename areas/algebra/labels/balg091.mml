<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">7</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
            <mn>3</mn>
        </mfrac>
        <mo>−</mo>
        <mfrac>
            <mrow>
                <mn>5</mn>
                <mo>−</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">2</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">2</mn>
                <mi arg="arg2">x</mi>
            </mrow>
        </mfrac>
        <mo>=</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">4</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>3</mn>
            </mrow>
            <mn>4</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <mrow>
                <mn>1</mn>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">4</mn>
                    <msup arg="arg2" intent="power($base,$exp)">
                        <mi arg="base">x</mi>
                        <mn arg="exp">2</mn>
                    </msup>
                </mrow>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">3</mn>
                <mi arg="arg2">x</mi>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
