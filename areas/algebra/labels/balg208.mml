<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <mi arg="arg2">m</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">8</mn>
            <mi arg="arg2">n</mi>
        </mrow>
        <mo>+</mo>
        <mn>5</mn>
        <mo>−</mo>
        <mi>m</mi>
        <mo>−</mo>
        <mi>n</mi>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <mi arg="arg2">m</mi>
        </mrow>
        <mo>−</mo>
        <mn>11</mn>
    </mrow>
</math>
