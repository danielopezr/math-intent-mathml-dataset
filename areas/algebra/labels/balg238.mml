<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>4</mn>
                <mn>7</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>9</mn>
                <mn>14</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
