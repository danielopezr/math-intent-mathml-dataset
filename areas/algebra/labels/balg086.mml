<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mi>x</mi>
                <mo>+</mo>
                <mn>3</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>x</mi>
                <mo>−</mo>
                <mn>3</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>−</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">x</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>−</mo>
        <mfrac>
            <mn>5</mn>
            <mn>4</mn>
        </mfrac>
        <mo>=</mo>
        <mo stretchy="false">(</mo>
        <mi>x</mi>
        <mo>−</mo>
        <mfrac>
            <mi>x</mi>
            <mn>5</mn>
        </mfrac>
        <mo stretchy="false">)</mo>
        <mo>−</mo>
        <mo stretchy="false">(</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">3</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>−</mo>
        <mfrac>
            <mn>3</mn>
            <mn>4</mn>
        </mfrac>
        <mo stretchy="false">)</mo>
        <mo>.</mo>
    </mrow>
</math>
