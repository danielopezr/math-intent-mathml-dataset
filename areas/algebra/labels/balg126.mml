<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mrow arg="exp">
                        <mi>a</mi>
                        <mo>+</mo>
                        <mn>1</mn>
                    </mrow>
                </msup>
                <mo>−</mo>
                <mn>8</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mrow arg="exp">
                        <mi>a</mi>
                        <mo>+</mo>
                        <mn>1</mn>
                    </mrow>
                </msup>
                <mo>+</mo>
                <mn>9</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
