<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>=</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">7</mn>
                    <msup intent="power($base, $exp)" arg="arg2">
                        <mi arg="base">x</mi>
                        <mn arg="exp">2</mn>
                    </msup>
                </mrow>
                <mo>+</mo>
                <mn>6</mn>
            </mrow>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">3</mn>
                <msup intent="power($a, $b)" arg="arg2">
                    <mi arg="a">x</mi>
                    <mn arg="b">2</mn>
                </msup>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
