<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mi arg="arg1">a</mi>
                    <mi arg="arg2">b</mi>
                </mrow>
                <mo>+</mo>
                <mn>3</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mn>3</mn>
                <mo>−</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mi arg="arg1">a</mi>
                    <mi arg="arg2">b</mi>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
