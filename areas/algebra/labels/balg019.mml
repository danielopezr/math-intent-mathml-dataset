<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
    <mo>=</mo>
    <msup intent="power($base, $exp)">
      <mrow>
        <mo>(</mo>
        <msqrt arg="base">
          <mrow>
            <mo>&#x2212;</mo>
            <mn>1</mn>
          </mrow>
        </msqrt>
        <mo>)</mo>
      </mrow>
      <mn arg="exp">4</mn>
    </msup>
    <mo>&#xD7;</mo>
    <msup intent="power($base, $exp)">
      <mrow>
        <mo>(</mo>
        <msqrt arg="base">
          <mrow>
            <mo>&#x2212;</mo>
            <mn>1</mn>
          </mrow>
        </msqrt>
        <mo>)</mo>
      </mrow>
      <mn arg="exp">2</mn>
    </msup>
</mrow>
</math>
