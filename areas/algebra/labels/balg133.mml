<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">x</mi>
            <mn arg="exp">4</mn>
        </msup>
        <mo>−</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">x</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>+</mo>
        <mi>x</mi>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">x</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <mn>5</mn>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">7</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>+</mo>
        <mn>6</mn>
        <mo>.</mo>
    </mrow>
</math>
