<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">m</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">n</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">6</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">m</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>;</mo>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">4</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">m</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">5</mn>
            <mi arg="arg2">m</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">n</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">n</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">m</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">n</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">6</mn>
            <mi arg="arg2">m</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">n</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>;</mo>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">m</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">2</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">m</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">n</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>.</mo>
    </mrow>
</math>
