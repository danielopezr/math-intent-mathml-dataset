<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
    <mo>=</mo>
    <mo>&#x2212;</mo>
    <msup intent="power($base, $exp)">
      <mn arg="base">2</mn>
      <mrow arg="exp">
        <mn>2</mn>
        <mo>&#xD7;</mo>
        <mn>3</mn>
      </mrow>
    </msup>
    <mo>=</mo>
    <mo>&#x2212;</mo>
    <msup intent="power($base, $exp)">
      <mn arg="base">2</mn>
      <mn arg="exp">6</mn>
    </msup>
</mrow>
</math>
