<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>5</mn>
                <mn>6</mn>
            </mfrac>
            <mi arg="arg2">m</mi>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>7</mn>
                <mn>8</mn>
            </mfrac>
            <mi arg="arg2">m</mi>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
