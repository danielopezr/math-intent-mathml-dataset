<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
            <mn arg="arg1">3</mn>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">c</mi>
            <msqrt arg="arg4">
                <mrow intent="times($arg1,$arg2,$arg3)">
                    <mn arg="arg1">2</mn>
                    <mi arg="arg2">a</mi>
                    <mi arg="arg3">b</mi>
                </mrow>
            </msqrt>
        </mrow>
        <mo>=</mo>
        <mn>3</mn>
        <mo>×</mo>
        <mn>2</mn>
        <mo>×</mo>
        <mfrac>
            <mn>1</mn>
            <mn>3</mn>
        </mfrac>
        <mo>×</mo>
        <msqrt>
            <mrow>
                <mn>2</mn>
                <mo>×</mo>
                <mn>2</mn>
                <mo>×</mo>
                <mn>9</mn>
            </mrow>
        </msqrt>
        <mo>=</mo>
        <mn>2</mn>
        <mo>×</mo>
        <msqrt>
            <mn>36</mn>
        </msqrt>
        <mo>=</mo>
        <mn>2</mn>
        <mo>×</mo>
        <mn>6</mn>
        <mo>=</mo>
        <mn>12</mn>
        <mo>.</mo>
    </mrow>
</math>
