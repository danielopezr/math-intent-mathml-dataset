<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>−</mo>
        <mo>(</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>−</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">3</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
            <mn>8</mn>
        </mfrac>
        <mo>)</mo>
        <mo>=</mo>
        <mrow intent="times($a, $b)">
            <mfrac arg="a">
                <mn>2</mn>
                <mn>3</mn>
            </mfrac>
            <mrow arg="b">
                <mo>(</mo>
                <mfrac>
                    <mrow>
                        <mi>x</mi>
                        <mo>+</mo>
                        <mn>2</mn>
                    </mrow>
                    <mn>6</mn>
                </mfrac>
                <mo>)</mo>
            </mrow>
            <mo>)</mo>
        </mrow>
        <mo>−</mo>
        <mfrac>
            <mn>1</mn>
            <mn>4</mn>
        </mfrac>
    </mrow>
</math>
