<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mrow intent="times($a, $b)"><mn arg="a">3</mn><mi arg="b">m</mi></mrow>
    <mo>−</mo><mrow intent="times($a, $b)"><mn arg="a">5</mn><mi arg="b">n</mi></mrow>
    <mo>+</mo><mn>6</mn>
    <mo>;</mo>
    <mo>−</mo><mrow intent="times($a, $b)"><mn arg="a">6</mn><mi arg="b">m</mi></mrow>
    <mo>+</mo><mn>8</mn>
    <mo>−</mo><mrow intent="times($a, $b)"><mn arg="a">20</mn><mi arg="b">n</mi></mrow>
    <mo>;</mo>
    <mo>−</mo><mrow intent="times($a, $b)"><mn arg="a">20</mn><mi arg="b">n</mi></mrow>
    <mo>+</mo><mrow intent="times($a, $b)"><mn arg="a">12</mn><mi arg="b">m</mi></mrow>
    <mo>−</mo><mn>12</mn>
  </mrow>
</math>