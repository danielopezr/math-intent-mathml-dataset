<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
  <mrow intent="times($a, $b)">
    <mrow arg="a">
        <mo>&#x2212;</mo>
        <mfrac>
           <mn>2</mn>
           <mn>5</mn>
        </mfrac>
    </mrow>
    <mrow arg="b" intent="times($arg1,$arg2)">
        <mi arg="arg1">b</mi>
        <msup intent="power($base, $exp)" arg="arg2">
            <mi arg="base">x</mi>
            <mn arg="exp">2</mn>
        </msup>
    </mrow>
  </mrow>  
  <mo>-</mo>
  <mrow intent="times($arg1,$arg2,$arg3)"><mn arg="arg1">4</mn>
  <mi arg="arg2">b</mi>
  <msup intent="power($base, $exp)" arg="arg3">
      <mi arg="base">x</mi>
      <mn arg="exp">2</mn>
  </msup></mrow>
  <mo>=</mo>
  <mrow intent="times($a, $b)">
    <mrow arg="a">
        <mo>-</mo>
        <mfrac>
            <mn>22</mn>
            <mn>5</mn>
        </mfrac>
    </mrow>
    <mrow arg="b" intent="times($arg1,$arg2)">
        <mi arg="arg1">b</mi>
        <msup intent="power($base, $exp)" arg="arg2">
            <mi arg="base">x</mi>
            <mn arg="exp">2</mn>
        </msup>
    </mrow>
  </mrow>
</mrow>
</math>
