<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>=</mo>
        <mrow>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2,$arg3)">
                <mfrac arg="arg1">
                    <mn>22</mn>
                    <mn>5</mn>
                </mfrac>
                <mi arg="arg2">b</mi>
                <msup intent="power($base, $exp)" arg="arg3">
                    <mi arg="base">x</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
