<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">7</mn>
            <mi arg="arg2">a</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">9</mn>
            <mi arg="arg2">b</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <mi arg="arg2">a</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <mi arg="arg2">b</mi>
        </mrow>
    </mrow>
</math>
