<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
    <msup intent="power($base, $exp)">
      <mrow>
        <mo>(</mo>
        <msqrt arg="base">
          <mrow>
            <mo>&#x2212;</mo>
            <mn>1</mn>
          </mrow>
        </msqrt>
        <mo>)</mo>
      </mrow>
      <mn arg="exp">4</mn>
    </msup>
    <mo>=</mo>
    <msup intent="power($b, $e)">
      <mrow>
        <mo>(</mo>
        <msqrt arg="b">
          <mrow>
            <mo>&#x2212;</mo>
            <mn>1</mn>
          </mrow>
        </msqrt>
        <mo>)</mo>
      </mrow>
      <mn arg="e">2</mn>
    </msup>
    <mo>&#xD7;</mo>
    <msup intent="power($base, $exp)">
      <mrow>
        <mo>(</mo>
        <msqrt arg="base">
          <mrow>
            <mo>&#x2212;</mo>
            <mn>1</mn>
          </mrow>
        </msqrt>
        <mo>)</mo>
      </mrow>
      <mn arg="exp">2</mn>
    </msup>
    <mo>=</mo>
    <mrow>
      <mo>(</mo>
      <mo>&#x2212;</mo>
      <mn>1</mn>
      <mo>)</mo>
    </mrow>
    <mo>&#xD7;</mo>
    <mrow>
      <mo>(</mo>
      <mo>&#x2212;</mo>
      <mn>1</mn>
      <mo>)</mo>
    </mrow>
    <mo>=</mo>
    <mn>1</mn>
</mrow>
</math>
