<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">b</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>5</mn>
                <mn>6</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">b</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>8</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>4</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">b</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>5</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
