<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <msqrt>
                    <mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </msqrt>
                <mo stretchy="false">)</mo>
            </mrow>
            <mn arg="exp">6</mn>
        </msup>
        <mo>=</mo>
        <msup intent="power($base,$exp)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <msqrt>
                    <mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </msqrt>
                <mo stretchy="false">)</mo>
            </mrow>
            <mn arg="exp">4</mn>
        </msup>
        <mo>×</mo>
        <msup intent="power($base,$exp)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <msqrt>
                    <mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </msqrt>
                <mo stretchy="false">)</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>=</mo>
        <mn>1</mn>
        <mo>×</mo>
        <mo stretchy="false">(</mo>
        <mo>−</mo>
        <mn>1</mn>
        <mo stretchy="false">)</mo>
        <mo>=</mo>
        <mo>−</mo>
        <mn>1</mn>
        <mo>,</mo>
        <mtext>etc.</mtext>
    </mrow>
</math>
