<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">4</mn>
                <msup arg="arg2" intent="power($base,$exp)">
                    <mi arg="base">d</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
            <mn>2</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">16</mn>
                <msup arg="arg2" intent="power($base,$exp)">
                    <mi arg="base">n</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
            <mn>2</mn>
        </mfrac>
        <mo>−</mo>
        <mn>1</mn>
        <mo>.</mo>
    </mrow>
</math>
