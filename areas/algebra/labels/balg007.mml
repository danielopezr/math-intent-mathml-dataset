<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="logarithm($var)">
            <mi>log</mi>
            <mrow>
                <mo>(</mo>
                <mrow arg="var">
                    <mi>A</mi>
                    <mo>&#xD7;</mo>
                    <mi>B</mi>
                </mrow>
                <mo>)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow intent="logarithm($var)">
            <mi>log</mi>
            <mi arg="var">A</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="logarithm($var)">
            <mi>log</mi>
            <mi arg="var">B</mi>
        </mrow>
    </mrow>
</math>
