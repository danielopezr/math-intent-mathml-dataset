<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">5</mn>
                    <msup arg="arg2" intent="power($base,$exp)">
                        <mi arg="base">x</mi>
                        <mn arg="exp">3</mn>
                    </msup>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">6</mn>
                    <msup arg="arg2" intent="power($base,$exp)">
                        <mi arg="base">m</mi>
                        <mn arg="exp">4</mn>
                    </msup>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>.</mo>
    </mrow>
</math>
