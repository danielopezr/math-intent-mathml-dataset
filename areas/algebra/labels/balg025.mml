<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow intent="times($a, $b)">
                <mn arg="a">3</mn>
                <mi arg="b">x</mi>
            </mrow>
            <mn>8</mn>
        </mfrac>
        <mo>−</mo>
        <mfrac>
            <mn>7</mn>
            <mn>10</mn>
        </mfrac>
        <mo>−</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($a, $b)">
                    <mn arg="a">12</mn>
                    <mi arg="b">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>5</mn>
            </mrow>
            <mn>16</mn>
        </mfrac>
        <mo>−</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($a, $b)">
                    <mn arg="a">2</mn>
                    <mi arg="b">x</mi>
                </mrow>
                <mo>−</mo>
                <mn>3</mn>
            </mrow>
            <mn>20</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <mrow>
                <mrow intent="times($a, $b)">
                    <mn arg="a">4</mn>
                    <mi arg="b">x</mi>
                </mrow>
                <mo>+</mo>
                <mn>9</mn>
            </mrow>
            <mn>4</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <mn>7</mn>
            <mn>80</mn>
        </mfrac>
        <mo>=</mo>
        <mn>0</mn>
    </mrow>
</math>
