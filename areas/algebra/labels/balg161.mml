<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mi>c</mi>
                <mo>−</mo>
                <mi>b</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>d</mi>
                <mo>−</mo>
                <mi>c</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg3">
                <mo stretchy="false">(</mo>
                <mi>b</mi>
                <mo>−</mo>
                <mi>a</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg4">
                <mo stretchy="false">(</mo>
                <mi>m</mi>
                <mo>−</mo>
                <mi>p</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
