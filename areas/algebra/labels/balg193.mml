<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <msup arg="arg1" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg2">y</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <msup arg="arg1" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg2">y</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
