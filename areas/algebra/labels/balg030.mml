<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <mrow intent="times($a, $b)">
                    <mn arg="a">32</mn>
                    <msup arg="b" intent="power($base, $exp)">
                        <mi arg="base">x</mi>
                        <mn arg="exp">5</mn>
                    </msup>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($a, $b)">
                    <mn arg="a">243</mn>
                    <msup arg="b" intent="power($base, $exp)">
                        <mi arg="base">y</mi>
                        <mn arg="exp">5</mn>
                    </msup>
                </mrow>
            </mrow>
            <mrow>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">2</mn>
                    <mi arg="arg2">x</mi>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">3</mn>
                    <mi arg="arg2">y</mi>
                </mrow>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
