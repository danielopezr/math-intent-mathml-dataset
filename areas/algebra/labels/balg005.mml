<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($a, $b)">
            <mi arg="a">c</mi>
            <mi arg="b">r</mi>
        </mrow>
        <mo>=</mo>
        <mrow>
            <mrow intent="times($a, $b)">
                <mi arg="a">i</mi>
                <msup arg="b" intent="power($base, $exp)">
                    <mrow arg="base">
                        <mo>(</mo>
                        <mrow>
                            <mn>1</mn>
                            <mo>+</mo>
                            <mi>r</mi>
                        </mrow>
                        <mo>)</mo>
                    </mrow>
                    <mrow arg="exp">
                        <mi>t</mi>
                        <mo>+</mo>
                        <mn>1</mn>
                    </mrow>
                </msup>
            </mrow>
            <mo>−</mo>
            <mrow intent="times($a, $b)">
                <mi arg="a">i</mi>
                <mrow arg="b">
                    <mo>(</mo>
                    <mn>1</mn>
                    <mo>+</mo>
                    <mi>r</mi>
                    <mo>)</mo>
                </mrow>
            </mrow>
        </mrow>
    </mrow>
</math>
