<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msqrt>
            <mi>a</mi>
        </msqrt>
        <mo>+</mo>
        <msqrt>
            <mi>b</mi>
        </msqrt>
        <mo>−</mo>
        <mrow intent="times($a, $b)">
            <mn arg="a">2</mn>
            <mi arg="b">c</mi>
        </mrow>
        <mo>+</mo>
        <msqrt>
            <mi>d</mi>
        </msqrt>
        <mo>.</mo>
    </mrow>
</math>
