<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>2</mn>
                <mn>5</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">x</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">x</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>10</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">x</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>20</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">x</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
