<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow>
            <mi>a</mi>
            <mo>+</mo>
            <mi>b</mi>
            <mo>+</mo>
            <mi>c</mi>
        </mrow>
        <mo>,</mo>
        <mspace width="0.5em"/>
        <mrow>
            <msup intent="power($base, $exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">5</mn>
                <mi arg="arg2">x</mi>
            </mrow>
            <mo>+</mo>
            <mn>6</mn>
        </mrow>
        <mo>,</mo>
        <mspace width="0.5em"/>
        <mrow>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">5</mn>
                <msup intent="power($base, $exp)" arg="arg2">
                    <mi arg="base">x</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">6</mn>
                <msup intent="power($base, $exp)" arg="arg2">
                    <mi arg="base">y</mi>
                    <mn arg="exp">3</mn>
                </msup>
            </mrow>
            <mo>+</mo>
            <mfrac>
                <msup intent="power($base, $exp)">
                    <mi arg="base">a</mi>
                    <mn arg="exp">2</mn>
                </msup>
                <mn>3</mn>
            </mfrac>
        </mrow>
    </mrow>
</math>
