<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>2</mn>
                <mn>5</mn>
            </mfrac>
            <msup intent="power($base, $exp)" arg="arg2">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>2</mn>
                <mn>5</mn>
            </mfrac>
            <msup intent="power($base, $exp)" arg="arg2">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
        <mo>.</mo>
    </mrow>
</math>
