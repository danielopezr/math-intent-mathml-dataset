<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
  <mrow intent="times($a, $b)">
    <mfrac arg="a">
      <mn>2</mn>
      <mn>5</mn>
    </mfrac>
    <mrow arg="b" intent="times($arg1,$arg2)">
       <msup intent="power($base, $exp)" arg="arg1">
          <mi arg="base">x</mi>
          <mn arg="exp">2</mn>
       </msup>
       <mi arg="arg2">y</mi>
    </mrow>
  </mrow>
  <mo>-</mo>
  <mrow intent="times($a, $b)">
    <mfrac arg="a">
      <mn>2</mn>
      <mn>5</mn>
    </mfrac>
    <mrow arg="b" intent="times($arg1,$arg2)">
       <msup intent="power($base, $exp)" arg="arg1">
          <mi arg="base">x</mi>
          <mn arg="exp">2</mn>
       </msup>
       <mi arg="arg2">y</mi>
    </mrow>
  </mrow>
  <mo>=</mo>
  <mn>0</mn>
</mrow>
</math>
