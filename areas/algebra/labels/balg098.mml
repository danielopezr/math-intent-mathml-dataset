<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">m</mi>
                    <mn arg="exp">12</mn>
                </msup>
                <mo>+</mo>
                <mn>1</mn>
            </mrow>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">m</mi>
                    <mn arg="exp">4</mn>
                </msup>
                <mo>+</mo>
                <mn>1</mn>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
