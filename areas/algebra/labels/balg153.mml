<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>+</mo>
        <mi>b</mi>
        <mo>=</mo>
        <msup intent="power($base,$exp)">
            <mn arg="base">2</mn>
            <mn arg="exp">2</mn>
        </msup>
        <mo>+</mo>
        <mn>3</mn>
        <mo>=</mo>
        <mn>4</mn>
        <mo>+</mo>
        <mn>3</mn>
        <mo>=</mo>
        <mn>7</mn>
    </mrow>
</math>
