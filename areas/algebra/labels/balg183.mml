<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">0.4</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>+</mo>
        <mn>31</mn>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>8</mn>
            </mfrac>
            <mi arg="arg2">x</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">y</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0.6</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">y</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>2</mn>
                <mn>5</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mi arg="arg3">y</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">0.2</mn>
            <mi arg="arg2">x</mi>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">y</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>4</mn>
            </mfrac>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">y</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
        <mo>−</mo>
        <mn>6</mn>
        <mo>.</mo>
    </mrow>
</math>
