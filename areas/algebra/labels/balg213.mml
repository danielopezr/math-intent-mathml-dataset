<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">8</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>+</mo>
                    <mn>2</mn>
                </mrow>
            </msup>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>+</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">25</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>+</mo>
                    <mn>2</mn>
                </mrow>
            </msup>
            <msup arg="arg3" intent="power($base,$exp)">
                <mi arg="base">b</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>+</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
