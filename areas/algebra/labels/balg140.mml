<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mi arg="exp">x</mi>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">3</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mn>2</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">5</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mn>1</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>;</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">7</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mrow arg="exp">
                <mi>x</mi>
                <mo>−</mo>
                <mn>4</mn>
            </mrow>
        </msup>
        <mo>;</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">a</mi>
            <mrow arg="exp">
                <mi>x</mi>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">13</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mrow arg="exp">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mn>3</mn>
                </mrow>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
