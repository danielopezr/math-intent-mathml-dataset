<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">a</mi>
            <mi arg="arg2">m</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>5</mn>
            </mfrac>
            <mi arg="arg2">a</mi>
            <mi arg="arg3">m</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
