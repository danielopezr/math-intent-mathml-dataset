<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>5</mn>
            </mfrac>
            <mi arg="arg2">c</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mn>2</mn>
            </mfrac>
            <mi arg="arg2">b</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">d</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
