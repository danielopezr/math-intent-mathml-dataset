<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mn arg="exp">15</mn>
                </msup>
                <mo>+</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">y</mi>
                    <mn arg="exp">15</mn>
                </msup>
            </mrow>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mn arg="exp">3</mn>
                </msup>
                <mo>+</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">y</mi>
                    <mn arg="exp">3</mn>
                </msup>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
