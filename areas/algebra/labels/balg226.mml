<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">5</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mi arg="exp">x</mi>
            </msup>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">9</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mi arg="exp">x</mi>
            </msup>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">35</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">a</mi>
                <mi arg="exp">x</mi>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
