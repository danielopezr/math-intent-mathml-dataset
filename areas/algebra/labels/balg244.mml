<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">1.2</mn>
            <mi arg="arg2">y</mi>
            <mi arg="arg3">z</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">3.4</mn>
            <mi arg="arg2">y</mi>
            <mi arg="arg3">z</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
