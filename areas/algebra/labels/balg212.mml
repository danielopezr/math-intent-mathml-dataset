<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">5</mn>
            <mi arg="arg2">m</mi>
            <mi arg="arg3">n</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>4</mn>
            </mfrac>
            <mi arg="arg2">m</mi>
            <mi arg="arg3">n</mi>
        </mrow>
    </mrow>
</math>
