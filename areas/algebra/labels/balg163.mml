<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">m</mi>
            <mi arg="arg3">x</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">b</mi>
                    <mn arg="exp">2</mn>
                </msup>
                <mo>+</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">c</mi>
                    <mn arg="exp">2</mn>
                </msup>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <msup arg="arg2" intent="power($base,$exp)">
                <mi arg="base">d</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
