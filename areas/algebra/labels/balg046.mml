<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow>
    <msup intent="power($base, $exp)">
      <mrow arg="base">
        <mo>(</mo>
        <msup intent="power($b, $e)">
          <mi arg="b">a</mi>
          <mi arg="e">n</mi>
        </msup>
        <mo>)</mo>
      </mrow>
      <mi arg="exp">m</mi>
    </msup>
    <mo>=</mo>
    <msup intent="power($base, $exp)">
      <mi arg="base">a</mi>
      <mrow arg="exp">
        <mi>n</mi>
        <mo>&#xD7;</mo>
        <mi>m</mi>
      </mrow>
    </msup>
    <mo>=</mo>
    <msup intent="power($base, $exp)">
      <mi arg="base">a</mi>
      <mrow arg="exp" intent="times($arg1,$arg2)">
        <mi arg="arg1">n</mi>
        <mi arg="arg2">m</mi>
      </mrow>
    </msup>
</mrow>
</math>
