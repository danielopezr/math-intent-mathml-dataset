<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">4</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">5</mn>
            <mi arg="arg2">y</mi>
        </mrow>
        <mo>;</mo>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">3</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">6</mn>
            <mi arg="arg2">y</mi>
        </mrow>
        <mo>−</mo>
        <mn>8</mn>
        <mo>;</mo>
        <mo>−</mo>
        <mi>x</mi>
        <mo>+</mo>
        <mi>y</mi>
        <mo>.</mo>
    </mrow>
</math>
