<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">9</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>−</mo>
        <mn>2</mn>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mn arg="arg1">7</mn>
            <mi arg="arg2">x</mi>
            <mrow arg="arg3">
                <mo stretchy="false">(</mo>
                <mfrac>
                    <mn>1</mn>
                    <mi>x</mi>
                </mfrac>
                <mo>−</mo>
                <mfrac>
                    <mn>1</mn>
                    <mn>2</mn>
                </mfrac>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mfrac>
            <mrow>
                <mn>1</mn>
                <mo>+</mo>
                <mfrac>
                    <mi>x</mi>
                    <mn>2</mn>
                </mfrac>
            </mrow>
            <mn>2</mn>
        </mfrac>
        <mo>+</mo>
        <mrow intent="mixed-fraction($int,$frac)">
            <mn arg="int">2</mn>
            <mfrac arg="frac">
                <mn>3</mn>
                <mn>4</mn>
            </mfrac>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
