<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">3</mn>
                <msup arg="arg2" intent="power($base,$exp)">
                    <mi arg="base">c</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
            <mn>4</mn>
        </mfrac>
        <mo>+</mo>
        <mfrac>
            <mrow intent="times($arg1,$arg2)">
                <mn arg="arg1">4</mn>
                <mi arg="arg2">n</mi>
            </mrow>
            <mi>m</mi>
        </mfrac>
    </mrow>
</math>
