<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">4</mn>
                    <mi arg="arg2">m</mi>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">8</mn>
                    <mi arg="arg2">p</mi>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">a</mi>
                    <mn arg="exp">2</mn>
                </msup>
                <mo>+</mo>
                <msup intent="power($base,$exp)">
                    <mi arg="base">b</mi>
                    <mn arg="exp">2</mn>
                </msup>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg3">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">6</mn>
                    <mi arg="arg2">n</mi>
                </mrow>
                <mo>−</mo>
                <mi>d</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
