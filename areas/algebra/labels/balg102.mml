<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mfrac>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mn arg="exp">24</mn>
                </msup>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
            <mrow>
                <msup intent="power($base,$exp)">
                    <mi arg="base">x</mi>
                    <mn arg="exp">6</mn>
                </msup>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </mfrac>
        <mo>.</mo>
    </mrow>
</math>
