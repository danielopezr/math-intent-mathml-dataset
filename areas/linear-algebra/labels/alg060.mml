<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow>
            <msubsup>
                <mo>∫</mo>
                <mi>a</mi>
                <mi>b</mi>
            </msubsup>
            <mrow intent="$name($var)">
                <mi arg="name">f</mi>
                <mo>(</mo>
                <mi arg="var">x</mi>
                <mo>)</mo>
            </mrow>
            <mrow>
                <mi>d</mi>
                <mi>x</mi>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow>
            <msubsup>
                <mo>∫</mo>
                <mi>a</mi>
                <mi>b</mi>
            </msubsup>
            <mrow>
                <mo>[</mo>
                <mrow intent="$name($var)">
                    <msub arg="name">
                        <mi>f</mi>
                        <mn>1</mn>
                    </msub>
                    <mo>(</mo>
                    <mi arg="var">x</mi>
                    <mo>)</mo>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($x, $y)">
                    <mi arg="x">i</mi>
                    <mrow arg="y" intent="$name($var)">
                        <msub arg="name">
                            <mi>f</mi>
                            <mn>2</mn>
                        </msub>
                        <mo>(</mo>
                        <mi arg="var">x</mi>
                        <mo>)</mo>
                    </mrow>
                </mrow>
                <mo>]</mo>
            </mrow>
            <mrow>
                <mi>d</mi>
                <mi>x</mi>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow>
            <mrow>
                <msubsup>
                    <mo>∫</mo>
                    <mi>a</mi>
                    <mi>b</mi>
                </msubsup>
                <mrow intent="$name($var)">
                    <msub arg="name">
                        <mi>f</mi>
                        <mn>1</mn>
                    </msub>
                    <mo>(</mo>
                    <mi arg="var">x</mi>
                    <mo>)</mo>
                </mrow>
                <mrow>
                    <mi>d</mi>
                    <mi>x</mi>
                </mrow>
            </mrow>
            <mo>+</mo>
            <mrow intent="times($x, $y)">
                <mi arg="x">i</mi>
                <mrow arg="y">
                    <msubsup>
                        <mo>∫</mo>
                        <mi>a</mi>
                        <mi>b</mi>
                    </msubsup>
                    <mrow intent="$name($var)">
                        <msub arg="name">
                            <mi>f</mi>
                            <mn>2</mn>
                        </msub>
                        <mo>(</mo>
                        <mi arg="var">x</mi>
                        <mo>)</mo>
                    </mrow>
                    <mrow>
                        <mi>d</mi>
                        <mi>x</mi>
                    </mrow>
                </mrow>
            </mrow>
        </mrow>
    </mrow>
</math>
