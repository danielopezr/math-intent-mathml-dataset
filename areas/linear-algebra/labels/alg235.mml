<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0</mn>
            <msub arg="arg2">
                <mi>x</mi>
                <mn>1</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0</mn>
            <msub arg="arg2">
                <mi>x</mi>
                <mn>2</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0</mn>
            <msub arg="arg2">
                <mi>x</mi>
                <mn>3</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0</mn>
            <msub arg="arg2">
                <mi>x</mi>
                <mn>4</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">0</mn>
            <msub arg="arg2">
                <mi>x</mi>
                <mn>5</mn>
            </msub>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
        <mo>,</mo>
    </mrow>
</math>
