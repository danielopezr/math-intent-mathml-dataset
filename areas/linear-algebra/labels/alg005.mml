<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>y</mi>
                <mn>3</mn>
            </msub>
            <mo>(</mo>
            <mi arg="var">t</mi>
            <mo>)</mo>
        </mrow>
        <mo>=</mo>
        <msup intent="power($base, $exp)">
            <mi arg="base">t</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>3</mn>
                <mn>5</mn>
            </mfrac>
            <mi arg="arg2">t</mi>
        </mrow>
    </mrow>
</math>
