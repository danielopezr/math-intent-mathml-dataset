<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mrow intent="determinant($arg)">
                    <mi>det</mi>
                    <mo stretchy="false">(</mo>
                    <mi arg="arg">A</mi>
                    <mo stretchy="false">)</mo>
                </mrow>
            </mfrac>
            <mrow arg="arg2">
                <mo stretchy="false">[</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mi arg="arg1">A</mi>
                    <mrow intent="$name($var)" arg="arg2">
                        <mi arg="name">adj</mi>
                        <mo stretchy="false">(</mo>
                        <mi arg="var">A</mi>
                        <mo stretchy="false">)</mo>
                    </mrow>
                </mrow>
                <mo stretchy="false">]</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mi>I</mi>
    </mrow>
</math>
