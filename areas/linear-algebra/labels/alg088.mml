<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="inner-product($arg1,$arg2)">
            <mi>⟨</mi>
            <mrow arg="arg1" intent="times($arg1,$arg2)">
                <mi arg="arg1">k</mi>
                <mi arg="arg2">𝐟</mi>
            </mrow>
            <mo>,</mo>
            <mi arg="arg2">𝐠</mi>
            <mi>⟩</mi>
        </mrow>
        <mo>=</mo>
        <msubsup>
            <mo>∫</mo>
            <mi>a</mi>
            <mi>b</mi>
        </msubsup>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <mi arg="arg1">k</mi>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">f</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg3">
                <mi arg="name">g</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mi>d</mi>
        <mi>x</mi>
        <mo>=</mo>
        <mi>k</mi>
        <msubsup>
            <mo>∫</mo>
            <mi>a</mi>
            <mi>b</mi>
        </msubsup>
        <mrow intent="times($arg1,$arg2)">
            <mrow intent="$name($var)" arg="arg1">
                <mi arg="name">f</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">g</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mi>d</mi>
        <mi>x</mi>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">k</mi>
            <mrow intent="inner-product($arg1,$arg2)" arg="arg2">
                <mi>⟨</mi>
                <mi arg="arg1">𝐟</mi>
                <mo>,</mo>
                <mi arg="arg2">𝐠</mi>
                <mi>⟩</mi>
            </mrow>
        </mrow>
    </mrow>
</math>
