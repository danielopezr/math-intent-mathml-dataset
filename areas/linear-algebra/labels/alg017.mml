<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="inner-product($arg1,$arg2)">
            <mi>⟨</mi>
            <mrow arg="arg1">
                <mi>𝐟</mi>
                <mo>+</mo>
                <mi>𝐠</mi>
            </mrow>
            <mo>,</mo>
            <mi arg="arg2">𝐬</mi>
            <mi>⟩</mi>
        </mrow>
        <mo>=</mo>
        <msubsup>
            <mo>∫</mo>
            <mi>a</mi>
            <mi>b</mi>
        </msubsup>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mrow intent="$name($var)">
                    <mi arg="name">f</mi>
                    <mo stretchy="false">(</mo>
                    <mi arg="var">x</mi>
                    <mo stretchy="false">)</mo>
                </mrow>
                <mo>+</mo>
                <mrow intent="$name($var)">
                    <mi arg="name">g</mi>
                    <mo stretchy="false">(</mo>
                    <mi arg="var">x</mi>
                    <mo stretchy="false">)</mo>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">s</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">x</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mi>d</mi>
        <mi>x</mi>
    </mrow>
</math>
