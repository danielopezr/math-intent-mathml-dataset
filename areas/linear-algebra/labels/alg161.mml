<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="inverse($base)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <msup intent="inverse($base)">
                    <mi arg="base">A</mi>
                    <mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </msup>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </msup>
        <mo>=</mo>
        <mi>A</mi>
    </mrow>
</math>
