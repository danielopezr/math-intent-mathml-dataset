                        </mtd>
                    </mtr>
                </mtable>
                <mo>)</mo>
            </mrow>
            <mrow intent="vector($vec)" arg="arg3">
                <mo>(</mo>
                <mtable arg="vec">
                    <mtr>
                        <mtd>
                            <msub>
                                <mi>b</mi>
