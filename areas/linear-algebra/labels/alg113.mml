                    </mtr>
                    <mtr>
                        <mtd>
                            <mo>⋮</mo>
                        </mtd>
                        <mtd>
                            <mo>⋮</mo>
                        </mtd>
                        <mtd/>
                        <mtd>
                            <mo>⋮</mo>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <msub>
                                <mi>A</mi>
                                <mrow intent="times($arg1,$arg2)">
                                    <mn arg="arg1">1</mn>
                                    <mi arg="arg2">n</mi>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>A</mi>
                                <mrow intent="times($arg1,$arg2)">
