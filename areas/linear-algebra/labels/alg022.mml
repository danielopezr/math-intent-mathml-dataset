<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>𝜑</mi>
                    <mn>0</mn>
                </msub>
                <mo>(</mo>
                <mi arg="var">x</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <mfrac>
                <mn>1</mn>
                <msqrt>
                    <mrow intent="times($a, $b)">
                        <mn arg="a">2</mn>
                        <mi arg="b">𝜋</mi>
                    </mrow>
                </msqrt>
            </mfrac>
        </mrow>
        <mo>,</mo>
        <mspace width="1em"/>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>𝜑</mi>
                    <mrow>
                        <mrow intent="times($a, $b)">
                            <mn arg="a">2</mn>
                            <mi arg="b">k</mi>
                        </mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </msub>
                <mo>(</mo>
                <mi arg="var">x</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <mfrac>
                <mrow intent="cosine($var)">
                    <mi>cos</mi>
                    <mrow arg="var" intent="times($a, $b)">
                        <mi arg="a">k</mi>
                        <mi arg="b">x</mi>
                    </mrow>
                </mrow>
                <msqrt>
                    <mi>𝜋</mi>
                </msqrt>
            </mfrac>
        </mrow>
        <mo>,</mo>
        <mspace width="1em"/>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>𝜑</mi>
                    <mrow intent="times($a, $b)">
                        <mn arg="a">2</mn>
                        <mi arg="b">k</mi>
                    </mrow>
                </msub>
                <mo>(</mo>
                <mi arg="var">x</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <mfrac>
                <mrow intent="sine($var)">
                    <mi>sen</mi>
                    <mrow arg="var" intent="times($a, $b)">
                        <mi arg="a">k</mi>
                        <mi arg="b">x</mi>
                    </mrow>
                </mrow>
                <msqrt>
                    <mi>𝜋</mi>
                </msqrt>
            </mfrac>
        </mrow>
        <mo>,</mo>
        <mspace width="1em"/>
        <mrow>
            <mtext>para</mtext>
            <mspace width="0.5em"/>
            <mi>k</mi>
            <mo>≥</mo>
            <mn>1</mn>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
