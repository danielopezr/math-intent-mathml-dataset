<math xmlns="http://www.w3.org/1998/Math/MathML">
        <mrow>
            <mrow intent="$name($var)">
                <mi arg="name">T</mi>
                <mo>(</mo>
                <mrow arg="var" intent="vector($vec)">
                    <mo>[</mo>
                    <mtable arg="vec">
                        <mtr>
                            <mtd><mi>x</mi></mtd>
                        </mtr>
                        <mtr>
                            <mtd><mi>y</mi></mtd>
                        </mtr>
                    </mtable>
                    <mo>]</mo>
                </mrow>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <mrow intent="times($A, $x)">
                <mo>[</mo>
                <mtable arg="A" intent=":matrix" columnspacing="2em">
                    <mtr>
                        <mtd>
                            <mrow intent="power(cosine($var), 2)">
                                <msup>
                                    <mi>cos</mi>
                                    <mn>2</mn>
                                </msup>
                                <mi arg="var">&#x1D703;</mi>
                            </mrow>
                        </mtd>
                        <mtd>
                            <mrow intent="times($a, $b)">
                               <mrow arg="a" intent="sine($var)">
                                    <mi>sen</mi>
                                    <mi arg="var">&#x1D703;</mi>
                               </mrow>
                               <mrow arg="b" intent="cosine($var)">
                                    <mi>cos</mi>
                                    <mi arg="var">&#x1D703;</mi>
                               </mrow>
                            </mrow>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <mrow intent="times($a, $b)">
                               <mrow arg="a" intent="sine($var)">
                                    <mi>sen</mi>
                                    <mi arg="var">&#x1D703;</mi>
                               </mrow>
                               <mrow arg="b" intent="cosine($var)">
                                    <mi>cos</mi>
                                    <mi arg="var">&#x1D703;</mi>
                               </mrow>
                            </mrow>
                        </mtd>
                        <mtd>
                            <mrow intent="power(sine($var), 2)">
                                <msup>
                                    <mi>sen</mi>
                                    <mn>2</mn>
                                </msup>
                                <mi arg="var">&#x1D703;</mi>
                            </mrow>
                        </mtd>
                    </mtr>
                </mtable>
                <mo>]</mo>
                <mo>[</mo>
                <mrow arg="x" intent="vector($vec)">
                    <mtable arg="vec">
                        <mtr>
                            <mtd><mi>x</mi></mtd>
                        </mtr>
                        <mtr>
                            <mtd><mi>y</mi></mtd>
                        </mtr>
                    </mtable>
                </mrow>
                <mo>]</mo>
            </mrow>
        </mrow>
</math>
