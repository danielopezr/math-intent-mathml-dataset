<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="inverse($base)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <mn arg="arg1">5</mn>
                    <msup arg="arg2" intent="transpose($base)">
                        <mi arg="base">A</mi>
                        <mi>T</mi>
                    </msup>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </msup>
        <mo>=</mo>
        <mo>[</mo>
        <mtable intent=":matrix">
            <mtr>
                <mtd>
                    <mrow>
                        <mo>−</mo>
                        <mn>3</mn>
                    </mrow>
                </mtd>
                <mtd>
                    <mrow>
                        <mo>−</mo>
                        <mn>1</mn>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mn>5</mn>
                </mtd>
                <mtd>
                    <mn>2</mn>
                </mtd>
            </mtr>
        </mtable>
        <mo>]</mo>
    </mrow>
</math>
