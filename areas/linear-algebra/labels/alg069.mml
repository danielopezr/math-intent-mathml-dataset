<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>𝐰</mi>
        <mo>=</mo>
        <mrow intent="times($a, $b)">
            <msub arg="a">
                <mi>k</mi>
                <mn>1</mn>
            </msub>
            <mrow arg="b">
                <msub>
                    <mi>𝐯</mi>
                    <mn>1</mn>
                </msub>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($a, $b)">
            <msub arg="a">
                <mi>k</mi>
                <mn>2</mn>
            </msub>
            <mrow arg="b">
                <msub>
                    <mi>𝐯</mi>
                    <mn>2</mn>
                </msub>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mo intent="ellipsis">…</mo>
        <mo>+</mo>
        <mrow intent="times($a, $b)">
            <msub arg="a">
                <mi>k</mi>
                <mi>r</mi>
            </msub>
            <mrow arg="b">
                <msub>
                    <mi>𝐯</mi>
                    <mi>r</mi>
                </msub>
            </mrow>
        </mrow>
    </mrow>
</math>
