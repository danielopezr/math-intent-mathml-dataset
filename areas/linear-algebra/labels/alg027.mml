<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msub>
            <mi>f</mi>
            <mi>n</mi>
        </msub>
        <mo>=</mo>
        <mrow>
            <munderover>
                <mo>&#x2211;</mo>
                <mrow>
                    <mi>k</mi>
                    <mo>=</mo>
                    <mn>0</mn>
                </mrow>
                <mrow intent="times($a, $b)">
                    <mn arg="a">2</mn>
                    <mi arg="b">n</mi>
                </mrow>
            </munderover>
            <mrow intent="times($a, $b)">
                <mrow arg="a" intent="inner-product($vec1, $vec2)">
                    <mo>(</mo>
                    <mi arg="vec1">f</mi>
                    <mo>,</mo>
                    <msub arg="vec2">
                        <mi>&#x1D711;</mi>
                        <mi>k</mi>
                    </msub>
                    <mo>)</mo>
                </mrow>
                <msub arg="b">
                    <mi>&#x1D711;</mi>
                    <mi>k</mi>
                </msub>
            </mrow>
        </mrow>
    </mrow>
</math>
