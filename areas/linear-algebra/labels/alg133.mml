<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="norm($a)">
            <mo fence="false" stretchy="false">‖</mo>
            <mrow arg="a">
                <msub>
                    <mi>proy</mi>
                    <mi>𝐚</mi>
                </msub>
                <mi>𝐮</mi>
            </mrow>
            <mo fence="false" stretchy="false">‖</mo>
        </mrow>
        <mo>=</mo>
        <mfrac>
            <mrow intent="absolute-value($a)">
                <mo stretchy="false">|</mo>
                <mrow arg="a">
                    <mi>𝐮</mi>
                    <mo>·</mo>
                    <mi>𝐚</mi>
                </mrow>
                <mo stretchy="false">|</mo>
            </mrow>
            <mrow intent="norm($a)">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐚</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
        </mfrac>
    </mrow>
</math>
