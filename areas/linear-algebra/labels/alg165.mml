<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="determinant($arg)">
            <mi>det</mi>
            <mo stretchy="false">(</mo>
            <mrow arg="arg">
                <mi>A</mi>
                <mo>+</mo>
                <mi>B</mi>
            </mrow>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>≠</mo>
        <mrow intent="determinant($arg)">
            <mi>det</mi>
            <mo stretchy="false">(</mo>
            <mi arg="arg">A</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>+</mo>
        <mrow intent="determinant($arg)">
            <mi>det</mi>
            <mo stretchy="false">(</mo>
            <mi arg="arg">B</mi>
            <mo stretchy="false">)</mo>
        </mrow>
    </mrow>
</math>
