<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">D</mi>
            <mo>(</mo>
            <mi arg="var">x</mi>
            <mo>)</mo>
        </mrow>
        <mo>=</mo>
        <mn>1</mn>
        <mo>=</mo>
        <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <mrow intent="times($a, $b)">
                <mn arg="a">0</mn>
                <mi arg="b">x</mi>
            </mrow>
            <mo>+</mo>
            <mrow intent="times($a, $b)">
                <mn arg="a">0</mn>
                <msup arg="b" intent="power($base, $exp)">
                    <mi arg="base">x</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
        </mrow>
        <mo>,</mo>
    </mrow>
</math>
