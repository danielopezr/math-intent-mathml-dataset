<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>𝐮</mi>
        <mo>·</mo>
        <mi>𝐯</mi>
        <mo>=</mo>
        <mrow>
            <mo stretchy="true" fence="true" form="prefix">{</mo>
            <mtable>
                <mtr>
                    <mtd columnalign="left">
                        <mrow intent="times($arg1,$arg2,$arg3)">
                            <mrow intent="norm($a)" arg="arg1">
                                <mo fence="false" stretchy="false">‖</mo>
                                <mi arg="a">𝐮</mi>
                                <mo fence="false" stretchy="false">‖</mo>
                            </mrow>
                            <mrow intent="norm($a)" arg="arg2">
                                <mo fence="false" stretchy="false">‖</mo>
                                <mi arg="a">𝐯</mi>
                                <mo fence="false" stretchy="false">‖</mo>
                            </mrow>
                            <mrow intent="cosine($arg)" arg="arg3">
                                <mi>cos</mi>
                                <mi arg="arg">θ</mi>
                            </mrow>
                        </mrow>
                    </mtd>
                    <mtd columnalign="left">
                        <mrow>
                            <mtext>si</mtext>
                            <mi>𝐮</mi>
                            <mo>≠</mo>
                            <mn mathvariant="bold">0</mn>
                            <mtext>y</mtext>
                            <mi>𝐯</mi>
                            <mo>≠</mo>
                            <mn mathvariant="bold">0</mn>
                        </mrow>
                    </mtd>
                </mtr>
                <mtr>
                    <mtd columnalign="left">
                        <mn>0</mn>
                    </mtd>
                    <mtd columnalign="left">
                        <mrow>
                            <mtext>si</mtext>
                            <mi>𝐮</mi>
                            <mo>=</mo>
                            <mn mathvariant="bold">0</mn>
                            <mtext>o</mtext>
                            <mi>𝐯</mi>
                            <mo>=</mo>
                            <mn mathvariant="bold">0</mn>
                        </mrow>
                    </mtd>
                </mtr>
            </mtable>
        </mrow>
    </mrow>
</math>
