<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mi arg="base">A</mi>
            <mn arg="exp">2</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">A</mi>
        </mrow>
        <mo>+</mo>
        <mi>I</mi>
        <mo>.</mo>
    </mrow>
</math>
