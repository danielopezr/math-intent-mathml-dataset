<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="dimension($space)">
            <mi>dim</mi>
            <mrow arg="space" intent="kernel($t)">
                <mi>N</mi>
                <mo>(</mo>
                <mi arg="t">T</mi>
                <mo>)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="dimension($space)">
            <mi>dim</mi>
            <mrow arg="space" intent="$name($var)">
                <mi arg="name">T</mi>
                <mo>(</mo>
                <mi arg="var">V</mi>
                <mo>)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow intent="dimension($space)">
            <mi>dim</mi>
            <mi arg="space">V</mi>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
