<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>[</mo>
        <mtable intent=":matrix">
            <mtr>
                <mtd>
                    <mrow intent="times($arg1,$arg2)">
                        <mfrac arg="arg1">
                            <mn>1</mn>
                            <mn>2</mn>
                        </mfrac>
                        <mrow arg="arg2">
                            <mo stretchy="false">(</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mi arg="exp">x</mi>
                            </msup>
                            <mo>+</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mrow arg="exp">
                                    <mo>−</mo>
                                    <mi>x</mi>
                                </mrow>
                            </msup>
                            <mo stretchy="false">)</mo>
                        </mrow>
                    </mrow>
                </mtd>
                <mtd>
                    <mrow intent="times($arg1,$arg2)">
                        <mfrac arg="arg1">
                            <mn>1</mn>
                            <mn>2</mn>
                        </mfrac>
                        <mrow arg="arg2">
                            <mo stretchy="false">(</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mi arg="exp">x</mi>
                            </msup>
                            <mo>−</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mrow arg="exp">
                                    <mo>−</mo>
                                    <mi>x</mi>
                                </mrow>
                            </msup>
                            <mo stretchy="false">)</mo>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow intent="times($arg1,$arg2)">
                        <mfrac arg="arg1">
                            <mn>1</mn>
                            <mn>2</mn>
                        </mfrac>
                        <mrow arg="arg2">
                            <mo stretchy="false">(</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mi arg="exp">x</mi>
                            </msup>
                            <mo>−</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mrow arg="exp">
                                    <mo>−</mo>
                                    <mi>x</mi>
                                </mrow>
                            </msup>
                            <mo stretchy="false">)</mo>
                        </mrow>
                    </mrow>
                </mtd>
                <mtd>
                    <mrow intent="times($arg1,$arg2)">
                        <mfrac arg="arg1">
                            <mn>1</mn>
                            <mn>2</mn>
                        </mfrac>
                        <mrow arg="arg2">
                            <mo stretchy="false">(</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mi arg="exp">x</mi>
                            </msup>
                            <mo>+</mo>
                            <msup intent="exponential($exp)">
                                <mi>e</mi>
                                <mrow arg="exp">
                                    <mo>−</mo>
                                    <mi>x</mi>
                                </mrow>
                            </msup>
                            <mo stretchy="false">)</mo>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
        </mtable>
        <mo>]</mo>
    </mrow>
</math>
