<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>p</mi>
                <mn>1</mn>
            </msub>
            <mo stretchy="false">(</mo>
            <mi arg="var">A</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow intent="$name($var)" arg="arg1">
                <msub arg="name">
                    <mi>p</mi>
                    <mn>2</mn>
                </msub>
                <mo stretchy="false">(</mo>
                <mi arg="var">A</mi>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow intent="$name($var)" arg="arg2">
                <msub arg="name">
                    <mi>p</mi>
                    <mn>3</mn>
                </msub>
                <mo stretchy="false">(</mo>
                <mi arg="var">A</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
