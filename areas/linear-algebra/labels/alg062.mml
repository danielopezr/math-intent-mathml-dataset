<math xmlns="http://www.w3.org/1998/Math/MathML" >
       <mrow>
            <msubsup>
                    <mo>&#x222B;</mo>
                    <mi>a</mi>
                    <mi>b</mi>
            </msubsup>
            <mrow intent="times($a, $b)">
                <mrow arg="a">
                    <mo>[</mo>
                    <mrow intent="$name($var)">
                        <msub arg="name">
                            <mi>f</mi>
                            <mn>1</mn>
                        </msub>
                        <mrow>
                            <mo>(</mo>
                            <mi arg="var">x</mi>
                            <mo>)</mo>
                        </mrow>
                    </mrow>
                    <mo>+</mo>
                    <mrow intent="times($x, $y)">
                        <mi arg="x">i</mi>
                        <mrow arg="y" intent="$name($var)">
                            <msub arg="name">
                                <mi>f</mi>
                                <mn>2</mn>
                            </msub>
                            <mrow>
                                <mo>(</mo>
                                <mi arg="var">x</mi>
                                <mo>)</mo>
                            </mrow>
                        </mrow>
                    </mrow>
                    <mo>]</mo>
                </mrow>
                <mrow arg="b">
                    <mo>[</mo>
                    <mrow intent="$name($var)">
                        <msub arg="name">
                            <mi>g</mi>
                            <mn>1</mn>
                        </msub>
                        <mo>(</mo>
                        <mi arg="var">x</mi>
                        <mo>)</mo>
                    </mrow>
                    <mo>&#x2212;</mo>
                    <mrow intent="times($x, $y)">
                        <mi arg="x">i</mi>
                        <mrow arg="y" intent="$name($var)">
                            <msub arg="name">
                                <mi>g</mi>
                                <mn>2</mn>
                            </msub>
                            <mo>(</mo>
                            <mi arg="var">x</mi>
                            <mo>)</mo>
                        </mrow>
                    </mrow>
                    <mo>]</mo>
                </mrow>
            </mrow>
            <mrow>
                <mi>d</mi>
                <mi>x</mi>
            </mrow>
       </mrow>
</math>
