<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mtable rowspacing="0.5em">
            <mtr>
                <mtd>
                    <mrow>
                        <msup intent="power($base, $exp)">
                            <mrow arg="base">
                                <mo>(</mo>
                                <mrow intent="cosine($var)">
                                    <mi>cos</mi>
                                    <mi arg="var">&#x1D703;</mi>
                                </mrow>
                                <mo>+</mo>
                                <mrow intent="times($a, $b)">
                                    <mi arg="a">i</mi>
                                    <mrow arg="b" intent="sine($var)">
                                        <mi>sen</mi>
                                        <mi arg="var">&#x1D703;</mi>
                                    </mrow>
                                </mrow>
                                <mo>)</mo>
                            </mrow>
                            <mn arg="exp">2</mn>
                        </msup>
                        <mo>=</mo>
                        <mrow intent="cosine($var)">
                            <mi>cos</mi>
                            <mrow arg="var" intent="times($arg1,$arg2)">
                                <mn arg="arg1">2</mn>
                                <mi arg="arg2">&#x1D703;</mi>
                            </mrow>
                        </mrow>
                        <mo>+</mo>
                        <mrow intent="times($a, $b)">
                            <mi arg="a">i</mi>
                            <mrow arg="b" intent="sine($var)">
                                <mi>sen</mi>
                                <mrow arg="var" intent="times($arg1,$arg2)">
                                    <mn arg="arg1">2</mn>
                                    <mi arg="arg2">&#x1D703;</mi>
                                </mrow>
                            </mrow>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <msup intent="power($base, $exp)">
                            <mrow arg="base">
                                <mo>(</mo>
                                <mrow intent="cosine($var)">
                                    <mi>cos</mi>
                                    <mi arg="var">&#x1D703;</mi>
                                </mrow>
                                <mo>+</mo>
                                <mrow intent="times($a, $b)">
                                    <mi arg="a">i</mi>
                                    <mrow arg="b" intent="sine($var)">
                                        <mi>sen</mi>
                                        <mi arg="var">&#x1D703;</mi>
                                    </mrow>
                                </mrow>
                                <mo>)</mo>
                            </mrow>
                            <mn arg="exp">3</mn>
                        </msup>
                        <mo>=</mo>
                        <mrow intent="cosine($var)">
                            <mi>cos</mi>
                            <mrow arg="var" intent="times($arg1,$arg2)">
                                <mn arg="arg1">3</mn>
                                <mi arg="arg2">&#x1D703;</mi>
                            </mrow>
                        </mrow>
                        <mo>+</mo>
                        <mrow intent="times($a, $b)">
                            <mi arg="a">i</mi>
                            <mrow arg="b" intent="sine($var)">
                                <mi>sen</mi>
                                <mrow arg="var" intent="times($arg1,$arg2)">
                                    <mn arg="arg1">3</mn>
                                    <mi arg="arg2">&#x1D703;</mi>
                                </mrow>
                            </mrow>
                        </mrow>
                    </mrow>
                </mtd>
            </mtr>
        </mtable>
    </mrow>
</math>
