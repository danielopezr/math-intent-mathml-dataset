<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>L</mi>
        <mo>=</mo>
        <msubsup>
            <mo>∫</mo>
            <mi>a</mi>
            <mi>b</mi>
        </msubsup>
        <msqrt>
            <mrow>
                <mn>1</mn>
                <mo>+</mo>
                <msup intent="power($base,$exp)">
                    <mrow arg="base">
                        <mo stretchy="false">[</mo>
                        <mrow intent="$name($var)">
                            <msup arg="name" intent="derivative($y,_x,1)">
                                <mi arg="y">f</mi>
                                <mi>′</mi>
                            </msup>
                            <mo stretchy="false">(</mo>
                            <mi arg="var">x</mi>
                            <mo stretchy="false">)</mo>
                        </mrow>
                        <mo stretchy="false">]</mo>
                    </mrow>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
        </msqrt>
        <mi>d</mi>
        <mi>x</mi>
    </mrow>
</math>
