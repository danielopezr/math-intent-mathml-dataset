<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>𝐮</mi>
        <mo>·</mo>
        <mi>𝐯</mi>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <msub arg="arg1">
                <mi>u</mi>
                <mn>1</mn>
            </msub>
            <msub arg="arg2">
                <mi>v</mi>
                <mn>1</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <msub arg="arg1">
                <mi>u</mi>
                <mn>2</mn>
            </msub>
            <msub arg="arg2">
                <mi>v</mi>
                <mn>2</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <msub arg="arg1">
                <mi>u</mi>
                <mn>3</mn>
            </msub>
            <msub arg="arg2">
                <mi>v</mi>
                <mn>3</mn>
            </msub>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mn>2</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mo>−</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo stretchy="false">(</mo>
                <mn>1</mn>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mn>2</mn>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mn>3</mn>
    </mrow>
</math>
