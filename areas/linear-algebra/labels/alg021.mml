<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base, $exp)">
            <mrow arg="base" intent="norm($vec)">
                <mo>‖</mo>
                <mrow arg="vec">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mi>t</mi>
                </mrow>
                <mo>‖</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>≥</mo>
        <msup intent="power($base, $exp)">
            <mrow arg="base" intent="norm($vec)">
                <mo>‖</mo>
                <mrow arg="vec">
                    <mi>x</mi>
                    <mo>−</mo>
                    <mi>s</mi>
                </mrow>
                <mo>‖</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>,</mo>
    </mrow>
</math>
