<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow intent="set($members)">
    <mo>(</mo>
    <mrow arg="members">
        <mn>1</mn>
        <mo>,</mo>
        <mspace width="0.5em"/>
        <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <mi>x</mi>
        </mrow>
        <mo>,</mo>
        <mspace width="0.5em"/>
        <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <mi>x</mi>
            <mo>+</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
        </mrow>
        <mo>,</mo>
        <mspace width="0.5em"/>
        <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <mi>x</mi>
            <mo>+</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">2</mn>
            </msup>
            <mo>+</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">x</mi>
                <mn arg="exp">3</mn>
            </msup>
        </mrow>
    </mrow>
    <mo>)</mo>
</mrow>
</math>
