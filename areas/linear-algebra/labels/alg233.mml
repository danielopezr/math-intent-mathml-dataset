<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mtable>
            <mtr>
                <mtd>
                    <mrow>
                        <msub>
                            <mi>x</mi>
                            <mn>1</mn>
                        </msub>
                        <mo>+</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mn arg="arg1">6</mn>
                            <msub arg="arg2">
                                <mi>x</mi>
                                <mn>2</mn>
                            </msub>
                        </mrow>
                        <mo>+</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mn arg="arg1">4</mn>
                            <msub arg="arg2">
                                <mi>x</mi>
                                <mn>5</mn>
                            </msub>
                        </mrow>
                        <mo>=</mo>
                        <mo>−</mo>
                        <mn>2</mn>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <msub>
                            <mi>x</mi>
                            <mn>3</mn>
                        </msub>
                        <mo>+</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mn arg="arg1">3</mn>
                            <msub arg="arg2">
                                <mi>x</mi>
                                <mn>5</mn>
                            </msub>
                        </mrow>
                        <mo>=</mo>
                        <mn>1</mn>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <msub>
                            <mi>x</mi>
                            <mn>4</mn>
                        </msub>
                        <mo>+</mo>
                        <mrow intent="times($arg1,$arg2)">
                            <mn arg="arg1">5</mn>
                            <msub arg="arg2">
                                <mi>x</mi>
                                <mn>5</mn>
                            </msub>
                        </mrow>
                        <mo>=</mo>
                        <mn>2</mn>
                    </mrow>
                </mtd>
            </mtr>
        </mtable>
    </mrow>
</math>
