<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>y</mi>
                    <mn>3</mn>
                </msub>
                <mo>(</mo>
                <mi arg="var">t</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">t</mi>
                <mn arg="exp">3</mn>
            </msup>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>3</mn>
                    <mn>5</mn>
                </mfrac>
                <mi arg="arg2">t</mi>
            </mrow>
        </mrow>
        <mo>,</mo>
        <mspace width="1em"/>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>y</mi>
                    <mn>4</mn>
                </msub>
                <mo>(</mo>
                <mi arg="var">t</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">t</mi>
                <mn arg="exp">4</mn>
            </msup>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>6</mn>
                    <mn>7</mn>
                </mfrac>
                <msup intent="power($base, $exp)" arg="arg2">
                    <mi arg="base">t</mi>
                    <mn arg="exp">2</mn>
                </msup>
            </mrow>
            <mo>+</mo>
            <mfrac>
                <mn>3</mn>
                <mn>35</mn>
            </mfrac>
        </mrow>
        <mo>,</mo>
        <mspace width="1em"/>
        <mrow>
            <mrow intent="$name($var)">
                <msub arg="name">
                    <mi>y</mi>
                    <mn>5</mn>
                </msub>
                <mo>(</mo>
                <mi arg="var">t</mi>
                <mo>)</mo>
            </mrow>
            <mo>=</mo>
            <msup intent="power($base, $exp)">
                <mi arg="base">t</mi>
                <mn arg="exp">5</mn>
            </msup>
            <mo>−</mo>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>10</mn>
                    <mn>9</mn>
                </mfrac>
                <msup intent="power($base, $exp)" arg="arg2">
                    <mi arg="base">t</mi>
                    <mn arg="exp">3</mn>
                </msup>
            </mrow>
            <mo>+</mo>
            <mrow intent="times($arg1,$arg2)">
                <mfrac arg="arg1">
                    <mn>5</mn>
                    <mn>21</mn>
                </mfrac>
                <mi arg="arg2">t</mi>
            </mrow>
        </mrow>
        <mo>.</mo>
    </mrow>
</math>
