<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>&#x1D711;</mi>
                <mrow intent="times($a, $b)">
                    <mn arg="a">2</mn>
                    <mi arg="b">k</mi>
                </mrow>
            </msub>
            <mo>(</mo>
            <mi arg="var">x</mi>
            <mo>)</mo>
        </mrow>
        <mo>=</mo>
        <mfrac>
            <mrow intent="sine($var)">
                <mi>sen</mi>
                <mrow arg="var" intent="times($a, $b)">
                    <mi arg="a">k</mi>
                    <mi arg="b">x</mi>
                </mrow>
            </mrow>
            <msqrt>
                <mi>&#x1D70B;</mi>
            </msqrt>
        </mfrac>
    </mrow>
</math>
