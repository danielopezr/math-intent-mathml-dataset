<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">A</mi>
            <mi arg="arg2">B</mi>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1">
                <mo>[</mo>
                <mtable intent=":matrix">
                    <mtr>
                        <mtd>
                            <mn>1</mn>
                        </mtd>
                        <mtd>
                            <mn>2</mn>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <mn>3</mn>
                        </mtd>
                        <mtd>
                            <mn>4</mn>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <mn>0</mn>
                        </mtd>
                        <mtd>
                            <mn>1</mn>
                        </mtd>
                    </mtr>
                </mtable>
                <mo>]</mo>
            </mrow>
            <mrow arg="arg2">
                <mo>[</mo>
                <mtable intent=":matrix">
                    <mtr>
                        <mtd>
                            <mn>4</mn>
                        </mtd>
                        <mtd>
                            <mn>3</mn>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <mn>2</mn>
                        </mtd>
                        <mtd>
                            <mn>1</mn>
                        </mtd>
                    </mtr>
                </mtable>
                <mo>]</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mo>[</mo>
        <mtable intent=":matrix">
            <mtr>
                <mtd>
                    <mn>8</mn>
                </mtd>
                <mtd>
                    <mn>5</mn>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mn>20</mn>
                </mtd>
                <mtd>
                    <mn>13</mn>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mn>2</mn>
                </mtd>
                <mtd>
                    <mn>1</mn>
                </mtd>
            </mtr>
        </mtable>
        <mo>]</mo>
    </mrow>
</math>
