<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mtext>a)</mtext>
        <mrow intent="$name($var)">
            <mi arg="name">p</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">x</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mi>x</mi>
        <mo>−</mo>
        <mn>2</mn>
    </mrow>
</math>
