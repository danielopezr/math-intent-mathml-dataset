<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="inverse($base)">
            <mrow arg="base">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2,$arg3)">
                    <mi arg="arg1">A</mi>
                    <mi arg="arg2">B</mi>
                    <mi arg="arg3">C</mi>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
            <mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </msup>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2,$arg3)">
            <msup arg="arg1" intent="inverse($base)">
                <mi arg="base">C</mi>
                <mrow>
                    <mo>−</mo>
                    <mn>1</mn>
                </mrow>
            </msup>
            <msup arg="arg2" intent="inverse($base)">
                <mi arg="base">B</mi>
                <mrow>
                    <mo>−</mo>
                    <mn>1</mn>
                </mrow>
            </msup>
            <msup arg="arg3" intent="inverse($base)">
                <mi arg="base">A</mi>
                <mrow>
                    <mo>−</mo>
                    <mn>1</mn>
                </mrow>
            </msup>
        </mrow>
    </mrow>
</math>
