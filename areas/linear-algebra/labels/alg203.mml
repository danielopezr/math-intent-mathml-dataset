<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>[</mo>
        <mtable intent=":matrix">
            <mtr>
                <mtd>
                    <mrow intent="cosine($arg)">
                        <mi>cos</mi>
                        <mi arg="arg">θ</mi>
                    </mrow>
                </mtd>
                <mtd>
                    <mrow intent="sine($arg)">
                        <mi>sen</mi>
                        <mi arg="arg">θ</mi>
                    </mrow>
                </mtd>
            </mtr>
            <mtr>
                <mtd>
                    <mrow>
                        <mo>−</mo>
                        <mrow intent="sine($arg)">
                            <mi>sen</mi>
                            <mi arg="arg">θ</mi>
                        </mrow>
                    </mrow>
                </mtd>
                <mtd>
                    <mrow intent="cosine($arg)">
                        <mi>cos</mi>
                        <mi arg="arg">θ</mi>
                    </mrow>
                </mtd>
            </mtr>
        </mtable>
        <mo>]</mo>
    </mrow>
</math>
