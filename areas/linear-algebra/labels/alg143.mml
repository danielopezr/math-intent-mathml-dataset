<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="power($base,$exp)">
            <mrow intent="norm($a)" arg="base">
                <mo fence="false" stretchy="false">‖</mo>
                <mover arg="a">
                    <mrow>
                        <mi>P</mi>
                        <mi>Q</mi>
                    </mrow>
                    <mo>→</mo>
                </mover>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>=</mo>
        <msup intent="power($base,$exp)">
            <mrow intent="norm($a)" arg="base">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐮</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>+</mo>
        <msup intent="power($base,$exp)">
            <mrow intent="norm($a)" arg="base">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐯</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mn arg="exp">2</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2,$arg3,$arg4)">
            <mn arg="arg1">2</mn>
            <mrow intent="norm($a)" arg="arg2">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐮</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mrow intent="norm($a)" arg="arg3">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐯</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
            <mrow intent="cosine($arg)" arg="arg4">
                <mi>cos</mi>
                <mi arg="arg">θ</mi>
            </mrow>
        </mrow>
    </mrow>
</math>
