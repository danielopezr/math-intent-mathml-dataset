<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mi>x</mi>
        <mo>=</mo>
        <mn>5</mn>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">t</mi>
        </mrow>
        <mo>,</mo>
        <mi>y</mi>
        <mo>=</mo>
        <mi>t</mi>
        <mo>.</mo>
    </mrow>
</math>
