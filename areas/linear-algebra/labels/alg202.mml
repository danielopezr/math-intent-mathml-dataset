<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">p</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">x</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <msup intent="power($base,$exp)">
            <mi arg="base">x</mi>
            <mn arg="exp">3</mn>
        </msup>
        <mo>−</mo>
        <mrow intent="times($arg1,$arg2)">
            <mn arg="arg1">2</mn>
            <mi arg="arg2">x</mi>
        </mrow>
        <mo>+</mo>
        <mn>4</mn>
    </mrow>
</math>
