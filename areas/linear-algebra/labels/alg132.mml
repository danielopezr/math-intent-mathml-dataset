<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">k</mi>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mi>𝐮</mi>
                <mo>·</mo>
                <mi>𝐯</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">k</mi>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <mrow intent="times($arg1,$arg2)">
                    <msub arg="arg1">
                        <mi>u</mi>
                        <mn>1</mn>
                    </msub>
                    <msub arg="arg2">
                        <mi>v</mi>
                        <mn>1</mn>
                    </msub>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <msub arg="arg1">
                        <mi>u</mi>
                        <mn>2</mn>
                    </msub>
                    <msub arg="arg2">
                        <mi>v</mi>
                        <mn>2</mn>
                    </msub>
                </mrow>
                <mo>+</mo>
                <mrow intent="times($arg1,$arg2)">
                    <msub arg="arg1">
                        <mi>u</mi>
                        <mn>3</mn>
                    </msub>
                    <msub arg="arg2">
                        <mi>v</mi>
                        <mn>3</mn>
                    </msub>
                </mrow>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
