<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mrow intent="absolute-value($a)">
                    <mo stretchy="false">|</mo>
                    <mrow arg="a">
                        <mi>𝐮</mi>
                        <mo>·</mo>
                        <mi>𝐚</mi>
                    </mrow>
                    <mo stretchy="false">|</mo>
                </mrow>
                <msup intent="power($base,$exp)">
                    <mrow intent="norm($a)" arg="base">
                        <mo fence="false" stretchy="false">‖</mo>
                        <mi arg="a">𝐚</mi>
                        <mo fence="false" stretchy="false">‖</mo>
                    </mrow>
                    <mn arg="exp">2</mn>
                </msup>
            </mfrac>
            <mrow intent="norm($a)" arg="arg2">
                <mo fence="false" stretchy="false">‖</mo>
                <mi arg="a">𝐚</mi>
                <mo fence="false" stretchy="false">‖</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
