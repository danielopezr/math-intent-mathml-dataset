<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <msup intent="inverse($base)">
            <mi arg="base">A</mi>
            <mrow>
                <mo>−</mo>
                <mn>1</mn>
            </mrow>
        </msup>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mfrac arg="arg1">
                <mn>1</mn>
                <mrow intent="determinant($arg)">
                    <mi>det</mi>
                    <mo stretchy="false">(</mo>
                    <mi arg="arg">A</mi>
                    <mo stretchy="false">)</mo>
                </mrow>
            </mfrac>
            <mrow intent="$name($var)" arg="arg2">
                <mi arg="name">adj</mi>
                <mo stretchy="false">(</mo>
                <mi arg="var">A</mi>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
