<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="determinant($mat)">
            <mo>|</mo>
            <mtable arg="mat" intent=":matrix">
                <mtr>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                </mtr>
                <mtr>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                </mtr>
                <mtr>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                    <mtd>
                        <mrow intent="times($arg1,$arg2)">
                            <mi arg="arg1">k</mi>
                            <msub arg="arg2">
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mrow>
                    </mtd>
                </mtr>
            </mtable>
            <mo>|</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <msup arg="arg1" intent="power($base,$exp)">
                <mi arg="base">k</mi>
                <mn arg="exp">3</mn>
            </msup>
            <mrow intent="determinant($mat)" arg="arg2">
                <mo>|</mo>
                <mtable arg="mat" intent=":matrix">
                    <mtr>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>1</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>2</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mtd>
                    </mtr>
                    <mtr>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>1</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>2</mn>
                                </mrow>
                            </msub>
                        </mtd>
                        <mtd>
                            <msub>
                                <mi>a</mi>
                                <mrow>
                                    <mn>3</mn>
                                    <mn>3</mn>
                                </mrow>
                            </msub>
                        </mtd>
                    </mtr>
                </mtable>
                <mo>|</mo>
            </mrow>
        </mrow>
    </mrow>
</math>
