<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <mi arg="name">T</mi>
            <mo stretchy="false">(</mo>
            <mi arg="var">𝐯</mi>
            <mo stretchy="false">)</mo>
        </mrow>
        <mo>=</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1" intent="inner-product($arg1,$arg2)">
                <mi>⟨</mi>
                <mi arg="arg1">𝐯</mi>
                <mo>,</mo>
                <msub arg="arg2">
                    <mi>𝐰</mi>
                    <mn>1</mn>
                </msub>
                <mi>⟩</mi>
            </mrow>
            <msub arg="arg2">
                <mi>𝐰</mi>
                <mn>1</mn>
            </msub>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mrow arg="arg1" intent="inner-product($arg1,$arg2)">
                <mi>⟨</mi>
                <mi arg="arg1">𝐯</mi>
                <mo>,</mo>
                <msub arg="arg2">
                    <mi>𝐰</mi>
                    <mn>2</mn>
                </msub>
                <mi>⟩</mi>
            </mrow>
            <msub arg="arg2">
                <mi>𝐰</mi>
                <mn>2</mn>
            </msub>
        </mrow>
    </mrow>
</math>
