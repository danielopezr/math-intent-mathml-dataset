<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="$name($var)">
            <msub arg="name">
                <mi>&#x1D711;</mi>
                <mn>0</mn>
            </msub>
            <mo>(</mo>
            <mi arg="var">x</mi>
            <mo>)</mo>
        </mrow>
        <mo>=</mo>
        <mfrac>
            <mn>1</mn>
            <msqrt>
                <mrow intent="times($a, $b)">
                    <mn arg="a">2</mn>
                    <mi arg="b">&#x1D70B;</mi>
                </mrow>
            </msqrt>
        </mfrac>
    </mrow>
</math>
