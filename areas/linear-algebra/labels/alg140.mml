<math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">a</mi>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <msub>
                    <mi>x</mi>
                    <mn>2</mn>
                </msub>
                <mo>−</mo>
                <msub>
                    <mi>x</mi>
                    <mn>1</mn>
                </msub>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>+</mo>
        <mrow intent="times($arg1,$arg2)">
            <mi arg="arg1">b</mi>
            <mrow arg="arg2">
                <mo stretchy="false">(</mo>
                <msub>
                    <mi>y</mi>
                    <mn>2</mn>
                </msub>
                <mo>−</mo>
                <msub>
                    <mi>y</mi>
                    <mn>1</mn>
                </msub>
                <mo stretchy="false">)</mo>
            </mrow>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
    </mrow>
</math>
